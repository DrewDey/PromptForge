# Supabase Configuration
# Create a free project at https://supabase.com
# Then copy your project URL and anon key from Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server/admin only. Never expose either value as NEXT_PUBLIC_.
# Prefer a current Supabase `sb_secret_…` key for server-side admin/source-run
# tools and the community project pilot. PathForge sends that opaque key only
# in the `apikey` header; it is never used as a bearer JWT. The legacy
# service-role JWT remains a temporary fallback while deployments migrate.
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates Vercel reconciliation plus GitHub's 15-minute report-alert
# recovery request. Generate a dedicated random value of at least 32 characters,
# keep it server-only, and mirror it into the PATHFORGE_CRON_SECRET repository secret.
CRON_SECRET=your_dedicated_cron_secret

# Required only when Request a Build transactional notifications are enabled.
# Keep the provider key server-only. The sender must be a verified address.
RESEND_API_KEY=re_your_server_only_resend_key
REQUEST_BUILD_NOTIFICATION_FROM=PathForge <requests@your-verified-domain.example>

# HMACs the trusted network address used by broad Request a Build intake.
# Use a dedicated random value of at least 32 characters. The raw address
# never leaves the application server or reaches Supabase.
REQUEST_BUILD_RATE_LIMIT_SECRET=your_dedicated_request_build_rate_limit_secret

# HMACs the trusted request address used by the public project-report throttle.
# Use a dedicated random value of at least 32 characters; raw addresses are never stored.
REPORT_RATE_LIMIT_SECRET=your_dedicated_report_rate_limit_secret

# Both distinct HTTPS destinations are required before publication or invited
# builders are enabled. They receive the same non-PII alert through independent
# primary and escalation channels.
COMMUNITY_PROJECT_ALERT_WEBHOOK_URL=https://your-operator-alert-endpoint.example/pathforge
COMMUNITY_PROJECT_ALERT_ESCALATION_WEBHOOK_URL=https://your-independent-escalation-endpoint.example/pathforge

# Local production-acceptance harness only; do not deploy unless the harness
# itself runs in that environment. Use an operator-controlled mailbox that
# accepts unique plus-address aliases, such as owner+pathforge-test@example.com.
COMMUNITY_PROJECT_ACCEPTANCE_EMAIL=

# Required by the server-side activation endpoint. Generate a dedicated random
# value; only its SHA-256 digest is deployed to the Edge gateway. Never expose it publicly.
ACTIVATION_INGEST_SECRET=your_dedicated_activation_ingest_secret

# Optional dedicated HMAC secret for the short-lived activation session cookie.
# When omitted, ACTIVATION_INGEST_SECRET is domain-separated and used as the
# signing key so no additional production secret is required.
ACTIVATION_COOKIE_SECRET=
