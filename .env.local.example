# Supabase Configuration
# Create a free project at https://supabase.com
# Then copy your project URL and anon key from Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server/admin only. Never expose this as NEXT_PUBLIC_.
# Required for local admin/source-run tools and server-side activation ingestion.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional dedicated HMAC secret for the short-lived activation session cookie.
# When omitted, the server-only Supabase service role key is domain-separated
# and used as the signing key so no additional production secret is required.
ACTIVATION_COOKIE_SECRET=
