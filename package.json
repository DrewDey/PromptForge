{
  "name": "pathforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run check:model-variants && node scripts/check-project-model-variant-live-registry.mjs",
    "build": "next build",
    "start": "next start",
    "check:hourly-seed-manager": "node scripts/check-hourly-seed-manager.mjs",
    "check:prompt-comparisons": "node scripts/check-prompt-comparisons.mjs",
    "check:model-variants": "node scripts/check-project-model-variants.mjs && node scripts/check-model-variant-ui-behavior.mjs && node scripts/check-project-model-variant-lineage.mjs && node scripts/check-project-model-variant-cohort.mjs",
    "check:model-variant-ui": "node scripts/check-model-variant-ui-behavior.mjs",
    "check:model-variant-browser": "node scripts/check-model-variant-page-browser.mjs",
    "check:artifact-sandbox": "node scripts/check-protected-artifact-sandbox.mjs",
    "check:model-variant-lineage": "node scripts/check-project-model-variant-lineage.mjs",
    "build:model-variant-launch": "node scripts/build-project-model-variant-manifests.mjs",
    "release:model-variants": "node scripts/release-project-model-variants.mjs",
    "measure:artifacts": "node scripts/measure-html-artifacts.mjs",
    "check:project-forks": "node scripts/check-project-forks.mjs && node scripts/check-project-fork-behavior.mjs && node scripts/check-prompt-comparisons.mjs",
    "check:source-run-intake": "node scripts/check-source-run-intake.mjs",
    "check:source-run-showcases": "node scripts/check-source-run-showcases.mjs && node scripts/check-protected-artifact-sandbox.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "autoreview": "npm run lint && npm run typecheck && npm run check:source-run-intake && npm run check:source-run-showcases && npm run check:model-variants && npm run check:project-forks",
    "autoreview:hourly-manager": "npm run check:hourly-seed-manager"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
