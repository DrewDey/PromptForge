      "response_exact": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pomodoro Focus Timer</title>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-family: Arial, sans-serif;\n      background: #f5f5f5;\n      color: #222;\n    }\n\n    .timer-card {\n      width: min(440px, 92vw);\n      padding: 40px 28px;\n      text-align: center;\n      background: white;\n      border-radius: 22px;\n      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);\n    }\n\n    h1 {\n      margin: 0 0 14px;\n      font-size: 28px;\n      font-weight: 700;\n    }\n\n    .mode {\n      margin-bottom: 18px;\n      font-size: 18px;\n      color: #666;\n    }\n\n    .countdown {\n      margin: 22px 0 28px;\n      font-size: clamp(64px, 18vw, 96px);\n      font-weight: 800;\n      letter-spacing: -4px;\n    }\n\n    .settings {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n      margin: 0 0 24px;\n    }\n\n    label {\n      display: flex;\n      flex-direction: column;\n      gap: 7px;\n      text-align: left;\n      font-size: 14px;\n      color: #555;\n      font-weight: 700;\n    }\n\n    input {\n      width: 100%;\n      padding: 11px 12px;\n      border: 1px solid #ddd;\n      border-radius: 12px;\n      font-size: 16px;\n      color: #222;\n      background: #fafafa;\n    }\n\n    input:disabled {\n      opacity: 0.6;\n      cursor: not-allowed;\n    }\n\n    .sessions {\n      margin-bottom: 24px;\n      font-size: 16px;\n      color: #555;\n    }\n\n    .sessions strong {\n      color: #222;\n    }\n\n    .buttons {\n      display: flex;\n      gap: 12px;\n      justify-content: center;\n      flex-wrap: wrap;\n    }\n\n    button {\n      border: none;\n      border-radius: 999px;\n      padding: 13px 22px;\n      font-size: 16px;\n      font-weight: 700;\n      cursor: pointer;\n      background: #222;\n      color: white;\n      transition: transform 0.12s ease, opacity 0.12s ease;\n    }\n\n    button:hover {\n      transform: translateY(-1px);\n      opacity: 0.9;\n    }\n\n    button.secondary {\n      background: #e9e9e9;\n      color: #222;\n    }\n\n    .hint {\n      margin-top: 26px;\n      font-size: 14px;\n      color: #777;\n      line-height: 1.4;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"timer-card\">\n    <h1>Pomodoro Timer</h1>\n    <div class=\"mode\" id=\"mode\">Work session</div>\n\n    <div class=\"settings\">\n      <label>\n        Work minutes\n        <input id=\"workInput\" type=\"number\" min=\"1\" max=\"180\" value=\"25\" />\n      </label>\n\n      <label>\n        Break minutes\n        <input id=\"breakInput\" type=\"number\" min=\"1\" max=\"60\" value=\"5\" />\n      </label>\n    </div>\n\n    <div class=\"countdown\" id=\"countdown\">25:00</div>\n\n    <div class=\"sessions\">\n      Work sessions completed: <strong id=\"sessionCount\">0</strong>\n    </div>\n\n    <div class=\"buttons\">\n      <button id=\"startBtn\">Start</button>\n      <button class=\"secondary\" id=\"pauseBtn\">Pause</button>\n      <button class=\"secondary\" id=\"resetBtn\">Reset</button>\n    </div>\n\n    <div class=\"hint\">Set your times, start focusing, and completed work sessions will be counted.</div>\n  </main>\n\n  <script>\n    let workSeconds = 25 * 60;\n    let breakSeconds = 5 * 60;\n    let isWorkSession = true;\n    let timeLeft = workSeconds;\n    let completedSessions = 0;\n    let timer = null;\n\n    const countdown = document.getElementById(\"countdown\");\n    const mode = document.getElementById(\"mode\");\n    const sessionCount = document.getElementById(\"sessionCount\");\n    const workInput = document.getElementById(\"workInput\");\n    const breakInput = document.getElementById(\"breakInput\");\n    const startBtn = document.getElementById(\"startBtn\");\n    const pauseBtn = document.getElementById(\"pauseBtn\");\n    const resetBtn = document.getElementById(\"resetBtn\");\n\n    function getMinutes(input, fallback) {\n      const value = parseInt(input.value, 10);\n      return Number.isFinite(value) && value > 0 ? value : fallback;\n    }\n\n    function applySettings() {\n      const workMinutes = getMinutes(workInput, 25);\n      const breakMinutes = getMinutes(breakInput, 5);\n\n      workSeconds = workMinutes * 60;\n      breakSeconds = breakMinutes * 60;\n\n      if (isWorkSession) {\n        timeLeft = workSeconds;\n      } else {\n        timeLeft = breakSeconds;\n      }\n\n      updateDisplay();\n    }\n\n    function setInputsDisabled(disabled) {\n      workInput.disabled = disabled;\n      breakInput.disabled = disabled;\n    }\n\n    function formatTime(seconds) {\n      const minutes = Math.floor(seconds / 60);\n      const remainingSeconds = seconds % 60;\n      return `${minutes}:${remainingSeconds.toString().padStart(2, \"0\")}`;\n    }\n\n    function updateDisplay() {\n      countdown.textContent = formatTime(timeLeft);\n      mode.textContent = isWorkSession ? \"Work session\" : \"Break time\";\n      sessionCount.textContent = completedSessions;\n      document.title = `${formatTime(timeLeft)} - ${isWorkSession ? \"Work\" : \"Break\"}`;\n    }\n\n    function switchSession() {\n      if (isWorkSession) {\n        completedSessions++;\n      }\n\n      isWorkSession = !isWorkSession;\n      timeLeft = isWorkSession ? workSeconds : breakSeconds;\n      updateDisplay();\n    }\n\n    function startTimer() {\n      if (timer) return;\n\n      applySettings();\n      setInputsDisabled(true);\n\n      timer = setInterval(() => {\n        if (timeLeft > 0) {\n          timeLeft--;\n          updateDisplay();\n        } else {\n          switchSession();\n        }\n      }, 1000);\n    }\n\n    function pauseTimer() {\n      clearInterval(timer);\n      timer = null;\n    }\n\n    function resetTimer() {\n      pauseTimer();\n      setInputsDisabled(false);\n      isWorkSession = true;\n      completedSessions = 0;\n      applySettings();\n    }\n\n    workInput.addEventListener(\"input\", () => {\n      if (!timer) applySettings();\n    });\n\n    breakInput.addEventListener(\"input\", () => {\n      if (!timer) applySettings();\n    });\n\n    startBtn.addEventListener(\"click\", startTimer);\n    pauseBtn.addEventListener(\"click\", pauseTimer);\n    resetBtn.addEventListener(\"click\", resetTimer);\n\n    updateDisplay();\n  </script>\n</body>\n</html>",
