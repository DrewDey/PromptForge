n        function render() {\n            poolContainer.innerHTML = '';\n            timelineContainer.innerHTML = '';\n\n            pool.forEach(card => {\n                poolContainer.appendChild(buildCardElement(card, false, 0));\n            });\n\n            timeline.forEach((card, index) => {\n                timelineContainer.appendChild(buildCardElement(card, true, index));\n            });\n            \n            btnCompile.disabled = gameResolved;\n        }\n\n        // --- Interactions ---\n        function moveCard(id, direction) {\n            if (direction === 'toTimeline') {\n                const idx = pool.findIndex(c => c.id === id);\n                if (idx > -1) {\n                    timeline.push(pool.splice(idx, 1)[0]);\n                }\n            } else if (direction === 'toPool') {\n                const idx = timeline.findIndex(c => c.id === id);\n                if (idx > -1) {\n                    pool.push(timeline.splice(idx, 1)[0]);\n                }\n            }\n            render();\n        }\n\n        function reorderTimeline(index, offset) {\n            const newIndex = index + offset;\n            if (newIndex >= 0 && newIndex < timeline.length) {\n                const temp = timeline[index];\n                timeline[index] = timeline[newIndex];\n                timeline[newIndex] = temp;\n                render();\n            }\n        }\n\n        // --- Logic & Scoring ---\n        function compileTimeline() {\n            if (timeline.length < initialCards.length) {\n                statusDisplay.className = 'status-msg error';\n                statusDisplay.textContent = 'ERROR: TIMELINE INCOMPLETE. PLACE ALL LOGS.';\n                return;\n            }\n\n            let seqCorrect = 0;\n            let anomalyCorrect = 0;\n\n            timeline.forEach((card, idx) => {\n                if (card.targetOrder === idx + 1) seqCorrect++;\n                if (card.selectedAnomaly === card.correctAnomaly) anomalyCorrect++;\n            });\n\n            const total = initialCards.length;\n            scoreDisplay.textContent = `SEQUENCE: ${seqCorrect}/${total} | ANOMALIES: ${anomalyCorrect}/${total}`;\n\n            if (seqCorrect === total && anomalyCorrect === total) {\n                statusDisplay.className = 'status-msg success';\n                statusDisplay.textContent = 'OVERRIDE ACCEPTED. SEQUENCE RESTORED.';\n                triggerWinState(seqCorrect, anomalyCorrect);\n            } else {\n                failedAttempts++;\n                statusDisplay.className = 'status-msg error';\n                statusDisplay.textContent = 'TIMELINE MISMATCH OR INCORRECT ANOMALIES DETECTED.';\n                \n                if (failedAttempts >= 1) {\n                    btnReveal.classList.remove('hidden');\n                }\n            }\n        }\n\n        function requestHint() {\n            hintDisplay.textContent = hints[hintIndex];\n            hintIndex = (hintIndex + 1) % hints.length;\n        }\n\n        function handleRevealClick() {\n            const step = btnReveal.dataset.step;\n            if (step === \"0\") {\n                btnReveal.textContent = \"CONFIRM REVEAL?\";\n                btnReveal.dataset.step = \"1\";\n            } else {\n                // Auto-solve\n                timeline = [...timeline, ...pool].sort((a, b) => a.targetOrder - b.targetOrder);\n                pool = [];\n                timeline.forEach(card => {\n                    card.selectedAnomaly = card.correctAnomaly;\n                });\n                \n                statusDisplay.className = 'status-msg error';\n                statusDisplay.textContent = 'CLASSIFIED LOGS REVEALED. MANUAL OVERRIDE INITIATED.';\n                scoreDisplay.textContent = 'AUTO-RESOLVED BY SYSTEM OVERRIDE';\n                triggerWinState(0, 0, true);\n            }\n        }\n\n        function triggerWinState(seqScore, anomScore, isForced = false) {\n            gameResolved = true;\n            btnReveal.classList.add('hidden');\n            hintDisplay.textContent = '';\n            \n            // Build Report\n            const dateStr = new Date().toISOString().replace('T', ' ').substring(0, 19);\n            const forcedTag = isForced ? \"[AUTO-RESOLVED VIA CLASSIFIED OVERRIDE]\\n\" : \"\";\n            \n            const report = `--- SECURITY OS SHIFT REPORT ---\\n` +\n                           `TIMESTAMP: ${dateStr}\\n` +\n                           `STATUS: CONTAINMENT BREACH LOGGED\\n` +\n                           forcedTag +\n                           `SEQUENCE SCORE: ${isForced ? 'N/A' : seqScore + '/5'}\\n` +\n                           `ANOMALY SCORE:  ${isForced ? 'N/A' : anomScore + '/5'}\\n` +\n                           `VERIFICATION: COMPLETE.`;\n            \n            reportArea.value = report;\n            reportContainer.classList.remove('hidden');\n            render(); // Rerender to disable buttons/inputs\n        }\n\n        function copyReport() {\n            if (navigator.clipboard && navigator.clipboard.writeText) {\n                navigator.clipboard.writeText(reportArea.value).then(() => {\n                    btnCopy.textContent = \"COPIED TO CLIPBOARD\";\n                    setTimeout(() => btnCopy.textContent = \"COPY SHIFT REPORT\", 2000);\n                }).catch(() => {\n                    btnCopy.textContent = \"COPY FAILED - SELECT MANUALLY\";\n                });\n            } else {\n                reportArea.select();\n                btnCopy.textContent = \"PRESS CTRL+C TO COPY\";\n            }\n        }\n\n        // --- Event Listeners ---\n        btnCompile.addEventListener('click', compileTimeline);\n        btnHint.addEventListener('click', requestHint);\n        btnReveal.addEventListener('click', handleRevealClick);\n        btnReset.addEventListener('click', initGame);\n        btnCopy.addEventListener('click', copyReport);\n\n        // Start\n     