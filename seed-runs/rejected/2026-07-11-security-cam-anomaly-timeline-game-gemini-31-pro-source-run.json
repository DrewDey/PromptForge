rea id=\"report-area\" readonly></textarea>\n            <button id=\"btn-copy\" style=\"margin-top: 10px;\">COPY SHIFT REPORT</button>\n        </div>\n    </div>\n\n    <script>\n        // --- Game Data ---\n        const initialCards = [\n            {\n                id: 'c1', originalTime: 'REC: 23:42:01', visual: '🛌',\n                desc: 'Subject asleep in containment cell. Glass is intact. Bio-monitor reads stable.',\n                options: ['None detected', 'Subject missing', 'Glass shattered'],\n                correctAnomaly: 0, targetOrder: 1\n            },\n            {\n                id: 'c2', originalTime: 'REC: 23:40:00', visual: '🚨',\n                desc: 'Emergency lights flashing. Glass is completely shattered outward. Subject is gone.',\n                options: ['Timestamp precedes incident', 'None detected', 'Subject is visible'],\n                correctAnomaly: 0, targetOrder: 5\n            },\n            {\n                id: 'c3', originalTime: 'REC: 23:45:10', visual: '💥',\n                desc: 'Subject is violently striking the glass. A spiderweb crack appears. Bio-monitor reads flatline.',\n                options: ['Glass repairing itself', 'Time moving backwards', 'Active subject has flatline'],\n                correctAnomaly: 2, targetOrder: 3\n            },\n            {\n                id: 'c4', originalTime: 'REC: 23:44:15', visual: '📈',\n                desc: 'Subject is writhing. Bio-monitor is spiking into the red zone. Glass remains intact.',\n                options: ['Bio-monitor offline', 'None detected', 'Multiple subjects'],\n                correctAnomaly: 1, targetOrder: 2\n            },\n            {\n                id: 'c5', originalTime: 'REC: [DATA_CORRUPT]', visual: '🕳️',\n                desc: 'Containment cell is empty. A large hole has formed in the cracked glass. Monitor offline.',\n                options: ['None detected', 'Subject asleep', 'Room is flooded'],\n                correctAnomaly: 0, targetOrder: 4\n            }\n        ];\n\n        const hints = [\n            \"HINT 1: Striking glass requires a pulse. Check the bio-monitors.\",\n            \"HINT 2: The subject was contained at 23:42. A timestamp before that showing an escape is fabricated.\",\n            \"HINT 3: Corrupt data usually happens immediately after a critical failure.\",\n            \"HINT 4: The correct flow: Asleep -> Agitated -> Breaking -> Broken -> Fabricated aftermath.\"\n        ];\n\n        // --- State ---\n        let pool = [];\n        let timeline = [];\n        let failedAttempts = 0;\n        let hintIndex = 0;\n        let gameResolved = false;\n\n        // --- DOM Elements ---\n        const poolContainer = document.getElementById('pool-container');\n        const timelineContainer = document.getElementById('timeline-container');\n        const statusDisplay = document.getElementById('status-display');\n        const scoreDisplay = document.getElementById('score-display');\n        const hintDisplay = document.getElementById('hint-display');\n        const btnCompile = document.getElementById('btn-compile');\n        const btnHint = document.getElementById('btn-hint');\n        const btnReveal = document.getElementById('btn-reveal');\n        const btnReset = document.getElementById('btn-reset');\n        const reportContainer = document.getElementById('report-container');\n        const reportArea = document.getElementById('report-area');\n        const btnCopy = document.getElementById('btn-copy');\n\n        // --- Initialization ---\n        function initGame() {\n            // Deep copy and shuffle initial cards\n            pool = JSON.parse(JSON.stringify(initialCards)).sort(() => Math.random() - 0.5);\n            \n            // Add a user selection property\n            pool.forEach(card => card.selectedAnomaly = null);\n            timeline = [];\n            \n            failedAttempts = 0;\n            hintIndex = 0;\n            gameResolved = false;\n            \n            btnReveal.classList.add('hidden');\n            btnReveal.dataset.step = \"0\";\n            btnReveal.textContent = \"REVEAL CLASSIFIED LOGS\";\n            \n            reportContainer.classList.add('hidden');\n            statusDisplay.className = 'status-msg';\n            statusDisplay.textContent = 'AWAITING COMPILATION...';\n            scoreDisplay.textContent = '';\n            hintDisplay.textContent = '';\n            \n            render();\n        }\n\n        // --- Rendering ---\n        function createEl(tag, className, textContent) {\n            const el = document.createElement(tag);\n            if (className) el.className = className;\n            if (textContent) el.textContent = textContent;\n            return el;\n        }\n\n        function buildCardElement(card, inTimeline, index) {\n            const cardEl = createEl('div', 'card');\n            \n            if (inTimeline) {\n                const indicator = createEl('div', 'timeline-indicator', `SEQUENCE T-0${index + 1}`);\n                cardEl.appendChild(indicator);\n            }\n\n            const header = createEl('div', 'card-header', card.originalTime);\n            const visual = createEl('div', 'card-visual', card.visual);\n            const desc = createEl('div', 'card-desc', card.desc);\n            \n            cardEl.appendChild(header);\n            cardEl.appendChild(visual);\n            cardEl.appendChild(desc);\n\n            // Anomaly selection\n            const anomalySec = createEl('div', 'anomaly-section');\n            anomalySec.appendChild(createEl('div', 'anomaly-title', 'MARK ANOMALY:'));\n            \n            const radioGroup = createEl('div', 'radio-group');\n            card.options.forEach((optText, optIdx) => {\n                const label = createEl('label', 'radio-label');\n                const radio = createEl('input');\n                radio.type = 'radio';\n                radio.name 