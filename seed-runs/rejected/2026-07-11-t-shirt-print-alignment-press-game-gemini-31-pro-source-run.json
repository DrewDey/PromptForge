      "response_exact": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>T-Shirt Print Alignment Game</title>\n    <style>\n        :root {\n            --shirt-bg: #e2e8f0;\n            --safe-zone: rgba(59, 130, 246, 0.2);\n            --safe-border: #3b82f6;\n            --text-color: #1e293b;\n            --btn-bg: #0f172a;\n            --btn-hover: #334155;\n        }\n\n        body {\n            margin: 0;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n            display: flex;\n            height: 100vh;\n            background-color: #f8fafc;\n            color: var(--text-color);\n        }\n\n        #sidebar {\n            width: 300px;\n            padding: 20px;\n            background: #ffffff;\n            border-right: 1px solid #cbd5e1;\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n            box-shadow: 2px 0 10px rgba(0,0,0,0.05);\n            z-index: 10;\n        }\n\n        h2 { margin-top: 0; font-size: 1.2rem; }\n\n        button {\n            padding: 10px 15px;\n            border: none;\n            border-radius: 6px;\n            background: var(--btn-bg);\n            color: white;\n            font-weight: 600;\n            cursor: pointer;\n            transition: background 0.2s;\n        }\n\n        button:hover { background: var(--btn-hover); }\n        button.action { background: #2563eb; }\n        button.action:hover { background: #1d4ed8; }\n        button.success { background: #16a34a; }\n        button.success:hover { background: #15803d; }\n\n        #status-panel {\n            margin-top: 20px;\n            padding: 15px;\n            border-radius: 6px;\n            background: #f1f5f9;\n            font-size: 0.9rem;\n            min-height: 80px;\n        }\n\n        #status-panel.error { background: #fee2e2; color: #991b1b; }\n        #status-panel.success { background: #dcfce3; color: #166534; }\n\n        #workspace {\n            flex: 1;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: radial-gradient(circle, #f8fafc 0%, #e2e8f0 100%);\n            overflow: hidden;\n            position: relative;\n        }\n\n        #shirt {\n            width: 400px;\n            height: 500px;\n            background: white;\n            border-radius: 60px 60px 20px 20px;\n            box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n            position: relative;\n        }\n\n        /* Simulating the collar */\n        #shirt::before {\n            content: '';\n            position: absolute;\n            top: -20px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 140px;\n            height: 40px;\n            background: radial-gradient(ellipse at bottom, transparent 40%, white 45%);\n            border-radius: 50%;\n            border-bottom: 2px solid #e2e8f0;\n        }\n\n        #safe-zone {\n            position: absolute;\n            top: 80px;\n            left: 50px;\n            right: 50px;\n            bottom: 60px;\n            border: 2px dashed var(--safe-border);\n            background: var(--safe-zone);\n            pointer-events: none;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        #safe-zone::after {\n            content: 'PRINT SAFE AREA';\n            color: #2563eb;\n            opacity: 0.5;\n            font-weight: bold;\n            letter-spacing: 2px;\n            font-size: 0.8rem;\n        }\n\n        .draggable {\n            position: absolute;\n            cursor: grab;\n            user-select: none;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border: 1px solid transparent;\n            z-index: 2;\n        }\n\n        .draggable:active { cursor: grabbing; box-shadow: 0 8px 15px rgba(0,0,0,0.2); }\n        .draggable.error { border-color: red; background-color: rgba(255,0,0,0.1); }\n\n        .block-text {\n            background: #1e293b;\n            color: white;\n            padding: 10px 20px;\n            font-weight: bold;\n            font-size: 1.2rem;\n            border-radius: 4px;\n        }\n\n        .block-icon {\n            background: #f59e0b;\n            color: white;\n            width: 60px;\n            height: 60px;\n            font-size: 2rem;\n            border-radius: 50%;\n        }\n\n        .delete-btn {\n            position: absolute;\n            top: -8px;\n            right: -8px;\n            width: 20px;\n            height: 20px;\n            background: red;\n            color: white;\n            border-radius: 50%;\n            font-size: 12px;\n            display: none;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n            z-index: 3;\n        }\n\n        .draggable:hover .delete-btn { display: flex; }\n    </style>\n</head>\n<body>\n\n    <div id=\"sidebar\">\n        <h2>Tools</h2>\n        <button id=\"add-text\">Add Text Block</button>\n        <button id=\"add-icon\">Add Icon Block</button>\n        \n        <hr style=\"width: 100%; border: 0; border-top: 1px solid #cbd5e1; margin: 10px 0;\">\n        \n        <button id=\"check-btn\" class=\"action\">Check Alignment</button>\n        <button id=\"copy-btn\" class=\"success\">Copy Layout Spec</button>\n\n        <div id=\"status-panel\">\n            <strong>Status:</strong><br>\n            <span id=\"status-text\">Add elements to the shirt to begin. Keep them inside the blue dashed area!</span>\n        </div>\n    </div>\n\n    <div id=\"workspace\">\n        <div id=\"shirt\">\n            <div id=\"safe-zone\" id=\"safe-zone-rect\"></div>\n        </div>\n    </div>\n\n    <script>\n        const shirt = document.getElementById('shirt');\n        const safeZone = document.getElementById('safe-zone');\n        const statusPanel = document.getElementById('status-panel');\n        const statusText = document.getElementById('status-text');\n        \n        let elementCount = 0;\n        let activeDragElement = null;\n        let offsetX = 0;\n        let offsetY = 0;\n\n        // --- Drag and Drop Logic ---\n        function startDrag(e) {\n            if (e.target.classList.contains('delete-btn')) return;\n            \n            const target = e.target.closest('.draggable');\n            if (!target) return;\n\n            activeDragElement = target;\n            const rect = activeDragElement.getBoundingClientRect();\n            \n            // Calculate offset based on mouse position relative to the element\n            offsetX = e.clientX - rect.left;\n            offsetY = e.clientY - rect.top;\n            \n            activeDragElement.style.zIndex = 100;\n        }\n\n        function drag(e) {\n            if (!activeDragElement) return;\n            e.preventDefault();\n\n            const shirtRect = shirt.getBoundingClientRect();\n            \n            // Calculate new position relative to the shirt container\n            let newX = e.clientX - shirtRect.left - offsetX;\n            let newY = e.clientY - shirtRect.top - offsetY;\n\n            // Keep within shirt bounds roughly\n            newX = Math.max(0, Math.min(newX, shirtRect.width - activeDragElement.offsetWidth));\n            newY = Math.max(0, Math.min(newY, shirtRect.height - activeDragElement.offsetHeight));\n\n            activeDragElement.style.left = `${newX}px`;\n            activeDragElement.style.top = `${newY}px`;\n            \n            // Clear errors on move\n            activeDragElement.classList.remove('error');\n        }\n\n        function endDrag() {\n            if (!activeDragElement) return;\n            activeDragElement.style.zIndex = 2;\n            activeDragElement = null;\n        }\n\n        document.addEventListener('mousedown', startDrag);\n        document.addEventListener('mousemove', drag);\n        document.addEventListener('mouseup', endDrag);\n\n        // --- Element Creation ---\n        function createBlock(type) {\n            elementCount++;\n            const el = document.createElement('div');\n            el.className = `draggable block-${type}`;\n            el.dataset.type = type;\n            el.dataset.id = `element-${elementCount}`;\n            \n            if (type === 'text') {\n                el.innerText = 'YOUR TEXT';\n            } else {\n                el.innerText = '★';\n            }\n\n            const del = document.createElement('div');\n            del.className = 'delete-btn';\n            del.innerText = '×';\n            del.onclick = () => el.remove();\n            el.appendChild(del);\n\n            // Default spawn position center of shirt\n            el.style.left = '150px';\n            el.style.top = '200px';\n\n            shirt.appendChild(el);\n            updateStatus('Element added. Drag to position.', '');\n        }\n\n        document.getElementById('add-text').addEventListener('click', () => createBlock('text'));\n        document.getElementById('add-icon').addEventListener('click', () => createBlock('icon'));\n\n        // --- Validation Logic ---\n        function checkOverlap(rect1, rect2) {\n            return !(rect1.right < rect2.left || \n                     rect1.left > rect2.right || \n                     rect1.bottom < rect2.top || \n                     rect1.top > rect2.bottom);\n        }\n\n        function checkAlignment() {\n            const elements = document.querySelectorAll('.draggable');\n            if (elements.length === 0) {\n                updateStatus('No elements to check.', '');\n                return false;\n            }\n\n            const safeRect = safeZone.getBoundingClientRect();\n            let hasErrors = false;\n            let errorMsg = [];\n\n            elements.forEach(el => el.classList.remove('error'));\n\n            // 1. Check Safe Margin Bounds\n            elements.forEach(el => {\n                const rect = el.getBoundingClientRect();\n                if (rect.left < safeRect.left || rect.right > safeRect.right || \n                    rect.top < safeRect.top || rect.bottom > safeRect.bottom) {\n                    el.classList.add('error');\n                    hasErrors = true;\n                    if (!errorMsg.includes('Element outside print-safe zone.')) {\n                        errorMsg.push('Element outside print-safe zone.');\n                    }\n                }\n            });\n\n            // 2. Check Readability (Overlap)\n            const elArray = Array.from(elements);\n            for (let i = 0; i < elArray.length; i++) {\n                for (let j = i + 1; j < elArray.length; j++) {\n                    if (checkOverlap(elArray[i].getBoundingClientRect(), elArray[j].getBoundingClientRect())) {\n                        elArray[i].classList.add('error');\n                        elArray[j].classList.add('error');\n                        hasErrors = true;\n                        if (!errorMsg.includes('Elements are overlapping (readability issue).')) {\n                            errorMsg.push('Elements are overlapping (readability issue).');\n                        }\n                    }\n                }\n            }\n\n            if (hasErrors) {\n                updateStatus(errorMsg.join('<br>'), 'error');\n                return false;\n            } else {\n                updateStatus('Perfect! Design is print-ready.', 'success');\n                return true;\n            }\n        }\n\n        document.getElementById('check-btn').addEventListener('click', checkAlignment);\n\n        // --- Export Spec Logic ---\n        document.getElementById('copy-btn').addEventListener('click', () => {\n            if (!checkAlignment()) {\n                updateStatus('Please fix errors before copying spec.', 'error');\n                return;\n            }\n\n            const elements = document.querySelectorAll('.draggable');\n            const spec = {\n                shirt_width: 400,\n                shirt_height: 500,\n                safe_zone: { top: 80, right: 50, bottom: 60, left: 50 },\n                elements: []\n            };\n\n            elements.forEach(el => {\n                spec.elements.push({\n                    id: el.dataset.id,\n                    type: el.dataset.type,\n                    x_position: parseInt(el.style.left, 10),\n                    y_position: parseInt(el.style.top, 10)\n                });\n            });\n\n            const specString = JSON.stringify(spec, null, 2);\n            navigator.clipboard.writeText(specString).then(() => {\n                const originalText = statusText.innerHTML;\n                updateStatus('Layout spec copied to clipboard!', 'success');\n            }).catch(err => {\n                updateStatus('Failed to copy. See console.', 'error');\n                console.error('Copy failed', err);\n            });\n        });\n\n        function updateStatus(msg, stateClass) {\n            statusText.innerHTML = msg;\n            statusPanel.className = '';\n            if (stateClass) statusPanel.classList.add(stateClass);\n        }\n    </script>\n</body>\n</html>",
