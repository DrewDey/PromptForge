ument.getElementById('shirt');\n        const safeZone = document.getElementById('safe-zone');\n        const results = document.getElementById('results');\n        const nudgeControls = document.getElementById('nudge-controls');\n        \n        let selectedEl = null;\n\n        function updateResults(text) {\n            results.textContent = text;\n        }\n\n        function createBlock(type) {\n            const el = document.createElement('div');\n            el.className = 'element';\n            el.textContent = type === 'text' ? 'TEXT' : '★';\n            el.dataset.type = type;\n            el.style.left = '100px';\n            el.style.top = '100px';\n            \n            el.addEventListener('mousedown', selectEl);\n            el.addEventListener('touchstart', selectEl);\n            shirt.appendChild(el);\n            selectEl({currentTarget: el});\n        }\n\n        function selectEl(e) {\n            if (selectedEl) selectedEl.classList.remove('selected');\n            selectedEl = e.currentTarget;\n            selectedEl.classList.add('selected');\n            nudgeControls.style.display = 'flex';\n        }\n\n        // Nudge / Move logic\n        function move(dx, dy) {\n            if (!selectedEl) return;\n            const x = parseInt(selectedEl.style.left) + dx;\n            const y = parseInt(selectedEl.style.top) + dy;\n            selectedEl.style.left = x + 'px';\n            selectedEl.style.top = y + 'px';\n        }\n\n        document.getElementById('n-up').addEventListener('click', () => move(0, -5));\n        document.getElementById('n-down').addEventListener('click', () => move(0, 5));\n        document.getElementById('n-left').addEventListener('click', () => move(-5, 0));\n        document.getElementById('n-right').addEventListener('click', () => move(5, 0));\n        document.getElementById('n-del').addEventListener('click', () => {\n            if (selectedEl) { selectedEl.remove(); selectedEl = null; nudgeControls.s