      "response_exact": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<title>Swish City — Arcade Hoops</title>\n<style>\n  html,body{\n    margin:0; height:100%; background:#05060d; overflow:hidden;\n    font-family:'Trebuchet MS','Segoe UI',Tahoma,sans-serif;\n    touch-action:none; -webkit-user-select:none; user-select:none; -webkit-tap-highlight-color:transparent;\n  }\n  #wrap{ position:fixed; inset:0; display:flex; align-items:center; justify-content:center; }\n  canvas{ display:block; background:#05060d; touch-action:none; box-shadow:0 0 70px rgba(0,0,0,.6); border-radius:6px; }\n</style>\n</head>\n<body>\n<div id=\"wrap\"><canvas id=\"c\"></canvas></div>\n<script>\n(function(){\n\"use strict\";\n\n// ---------- core setup ----------\nconst W = 720, H = 1280;\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\ncanvas.width = W; canvas.height = H;\n\n// cached static background\nconst bg = document.createElement('canvas'); bg.width = W; bg.height = H;\nconst bgx = bg.getContext('2d');\n\n// ---------- geometry & constants ----------\nconst BB_W = 300, BB_H = 160, BB_TOP = 120;   // backboard\nconst RIM_Y = 300, RIM_R = 58;                // rim\nconst NET_DEPTH = 78;\nconst MUTE_RECT = { x:18, y:H-72, w:56, h:56 };\nconst BRICK_BAND = 85;                         // px past makeWin that still clanks rim\nconst SHOOTERS = 4;                            // four shooters across the bottom\nconst SHOTS_PER_ROUND = SHOOTERS;\nconst START_LIVES = 5, MAX_LIVES = 7;\nconst AMP = W/2 - 92;                           // ball sweep amplitude\n\nconst COL = {\n  bgTop:'#0b1026', bgBot:'#05060d',\n  woodTop:'#8a6a32', woodBot:'#cca45f', woodLine:'rgba(110,80,35,.5)',\n  line:'rgba(245,241,230,.65)',\n  board:'#eef3ff', boardEdge:'#9fb4e6', target:'#ff5a3c',\n  rim:'#ff7a1a', rimDark:'#c85a00', net:'rgba(233,238,252,.85)',\n  ballA:'#ffa55a', ball:'#ee7a2c', ballDark:'#c85a12', seam:'#3a1d08',\n  gold:'#ffd23f', green:'#5cf06c', red:'#ff5a3c', cyan:'#7cdcff', white:'#ffffff', fire:'#ff7a1a',\n  hudDim:'#9fb0d6'\n};\n\n// ---------- state ----------\nlet state = 'menu'; // menu | playing | shooting | over\nlet score = 0, best = 0, round = 1, shotsInRound = 0, streak = 0, lives = START_LIVES;\nlet onFire = false, pendingGameOver = false, bestIsNew = false;\nlet cfg = distanceConfig(1);\nlet currentBaseY = cfg.baselineY, targetBaseY = cfg.baselineY;\nlet ballPhase = -Math.PI/2, swayPhase = 0, hoopX = W/2;\nlet ball = { x:W/2, y:currentBaseY-86, r:30 };\nlet shot = null;\nlet shooters = [];\nlet callouts = [], particles = [], bolts = [], trail = [];\nlet shake = 0, flash = 0, netWiggle = 0;\n\n// ---------- audio ----------\nlet audioCtx = null, muted = false;\nfunction initAudio(){\n  if(!audioCtx){ try{ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ audioCtx=null; } }\n  if(audioCtx && audioCtx.state==='suspended'){ audioCtx.resume().catch(()=>{}); }\n}\nfunction blip(o){\n  if(muted || !audioCtx) return;\n  const t0 = audioCtx.currentTime + (o.delay||0);\n  const osc = audioCtx.createOscillator(), g = audioCtx.createGain();\n  osc.type = o.type || 'sine';\n  osc.frequency.setValueAtTime(o.freq, t0);\n  if(o.slideTo) osc.frequency.exponentialRampToValueAtTime(o.slideTo, t0 + o.dur);\n  g.gain.setValueAtTime(0.0001, t0);\n  g.gain.exponentialRampToValueAtTime(o.gain||0.15, t0+0.012);\n  g.gain.exponentialRampToValueAtTime(0.0001, t0+(o.dur||0.15));\n  osc.connect(g).connect(audioCtx.destination);\n  osc.start(t0); osc.stop(t0+(o.dur||0.15)+0.03);\n}\nfunction noise(o){\n  if(muted || !audioCtx) return;\n  const t0 = audioCtx.currentTime + (o.delay||0);\n  const dur = o.dur||0.2;\n  const buf = audioCtx.createBuffer(1, Math.max(1,(audioCtx.sampleRate*dur)|0), audioCtx.sampleRate);\n  const d = buf.getChannelData(0);\n  for(let i=0;i<d.length;i++) d[i] = Math.random()*2-1;\n  const src = audioCtx.createBufferSource(); src.buffer = buf;\n  const f = audioCtx.createBiquadFilter(); f.type = o.type||'highpass'; f.frequency.value = o.freq||1000;\n  const g = audioCtx.createGain();\n  g.gain.setValueAtTime(o.gain||0.15, t0);\n  g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);\n  src.connect(f).connect(g).connect(audioCtx.destination);\n  src.start(t0); src.stop(t0+dur);\n}\nconst sfxShoot = ()=>{ noise({dur:.18,gain:.10,type:'highpass',freq:900}); blip({freq:300,slideTo:520,type:'sine',dur:.18,gain:.07}); };\nconst sfxSwish = ()=>{ noise({dur:.22,gain:.10,type:'highpass',freq:2600}); blip({freq:660,slideTo:990,type:'triangle',dur:.16,gain:.18}); blip({freq:990,slideTo:1320,type:'triangle',dur:.18,gain:.13,delay:.08}); };\nconst sfxMake  = ()=>{ noise({dur:.16,gain:.07,type:'highpass',freq:2200}); blip({freq:520,slideTo:760,type:'triangle',dur:.16,gain:.16}); };\nconst sfxBrick = ()=>{ blip({freq:240,type:'square',dur:.10,gain:.18}); blip({freq:150,type:'square',dur:.12,gain:.13,delay:.05}); noise({dur:.10,gain:.07,type:'bandpass',freq:500}); };\nconst sfxAir   = ()=>{ blip({freq:520,slideTo:140,type:'sine',dur:.4,gain:.15}); };\nconst sfxLight = ()=>{ noise({dur:.5,gain:.22,type:'highpass',freq:400}); blip({freq:1400,slideTo:120,type:'sawtooth',dur:.45,gain:.18}); blip({freq:90,type:'square',dur:.3,gain:.2,delay:.02}); };\nconst sfxBonus = ()=>{ [0,.06,.12,.18].forEach((d,i)=>blip({freq:520+i*180,type:'triangle',dur:.12,gain:.13,delay:d})); };\nconst sfxStep  = ()=>{ blip({freq:300,type:'square',dur:.1,gain:.12}); blip({freq:440,type:'square',dur:.12,gain:.12,delay:.07}); };\nconst sfxStart = ()=>{ [0,.08,.16].forEach((d,i)=>blip({freq:400+i*200,type:'triangle',dur:.12,gain:.15,delay:d})); };\nconst sfxBuzz  = ()=>{ blip({freq:150,type:'square',dur:.7,gain:.22}); blip({freq:120,type:'square',dur:.7,gain:.16}); };\nconst sfxClick = ()=>{ blip({freq:600,type:'sine',dur:.06,gain:.1}); };\n\n// ---------- persistence (sandbox-safe) ----------\nasync function loadBest(){\n  try{ if(window.storage){ const r = await window.storage.get('swishcity_best', false); if(r && r.value){ best = parseInt(r.value)||0; } } }catch(e){}\n}\nasync function saveBest(v){\n  try{ if(window.storage){ await window.storage.set('swishcity_best', String(v), false); } }catch(e){}\n}\nloadBest();\n\n// ---------- helpers ----------\nconst lerp = (a,b,t)=>a+(b-a)*t;\nconst clamp = (v,a,b)=> v<a?a:(v>b?b:v);\nconst pick = a => a[(Math.random()*a.length)|0];\nfunction rr(c,x,y,w,h,r){ c.beginPath(); c.moveTo(x+r,y); c.arcTo(x+w,y,x+w,y+h,r); c.arcTo(x+w,y+h,x,y+h,r); c.arcTo(x,y+h,x,y,r); c.arcTo(x,y,x+w,y,r); c.closePath(); }\nfunction text(c,str,x,y,o){\n  o = o||{};\n  const size=o.size||40, weight=o.weight||'800', align=o.align||'center', baseline=o.baseline||'middle';\n  c.save();\n  c.globalAlpha = (o.alpha==null?1:o.alpha);\n  c.font = weight+' '+size+\"px 'Trebuchet MS','Segoe UI',sans-serif\";\n  c.textAlign = align; c.textBaseline = baseline;\n  try{ c.letterSpacing = (o.spacing||0)+'px'; }catch(e){}\n  if(o.glow){ c.shadowColor = o.glow; c.shadowBlur = o.gb||0; }\n  if(o.stroke){ c.lineWidth = o.sw||6; c.strokeStyle = o.stroke; c.lineJoin='round'; c.strokeText(str,x,y); }\n  c.fillStyle = o.color||'#fff'; c.fillText(str,x,y);\n  try{ c.letterSpacing = '0px'; }catch(e){}\n  c.restore();\n}\n\n// ---------- difficulty ----------\nfunction distanceConfig(r){\n  const tiers = [\n    {name:'LAYUP LINE', base:2},\n    {name:'FREE THROW', base:2},\n    {name:'MID-RANGE',  base:2},\n    {name:'DOWNTOWN',   base:3},\n    {name:'DEEP THREE', base:3},\n    {name:'HALF COURT', base:4},\n    {name:'FULL COURT', base:5}\n  ];\n  const i = Math.min(r-1, tiers.length-1);\n  return {\n    name: tiers[i].name,\n    base: tiers[i].base,\n    baselineY: Math.min(560 + (r-1)*100, 1130),\n    period:    Math.max(2.3 - (r-1)*0.18, 0.85),\n    makeWin:   Math.max(82 - (r-1)*7, 28),\n    perfWin:   Math.max(30 - (r-1)*2.6, 10),\n    sway:      r>=5 ? Math.min((r-4)*7, 32) : 0\n  };\n}\nfunction rank(s){\n  if(s>=400) return 'HALL OF FAMER';\n  if(s>=250) return 'ALL-STAR';\n  if(s>=150) return 'STARTER';\n  if(s>=70)  return 'ROLE PLAYER';\n  if(s>=25)  return 'BENCH SPARK';\n  return 'ROOKIE';\n}\n\n// ---------- shooters ----------\nfunction initShooters(){\n  shooters = [];\n  const jerseys = ['#e8413a','#2f6fed','#22b35e','#9b5cf0'];\n  for(let i=0;i<SHOOTERS;i++){\n    const x = lerp(140, W-140, i/(SHOOTERS-1));\n    shooters.push({ x, jersey:jerseys[i%jerseys.length], jump:0, bob:Math.random()*Math.PI*2 });\n  }\n}\n\n// ---------- effects ----------\nfunction addCallout(txt,x,y,color,o){ o=o||{}; callouts.push({txt,x,y,color,t:0,life:o.life||1.0,size:o.size||56,vy:(o.vy==null?-26:o.vy)}); }\nfunction updateCallouts(dt){ for(const c of callouts){ c.t+=dt; c.y+=c.vy*dt; } callouts = callouts.filter(c=>c.t<c.life); }\nfunction drawCallouts(){\n  for(const c of callouts){\n    const p = c.t/c.life;\n    let sc; if(p<0.16) sc=lerp(0.4,1.18,p/0.16); else if(p<0.28) sc=lerp(1.18,1,(p-0.16)/0.12); else sc=1;\n    let a=1; if(p>0.72) a=Math.max(0,1-(p-0.72)/0.28);\n    text(ctx,c.txt,c.x,c.y,{size:c.size*sc,color:c.color,weight:'900',glow:c.color,gb:14,stroke:'rgba(0,0,0,.85)',sw:c.size*0.12*sc,alpha:a,spacing:1});\n  }\n}\nfunction updateParticles(dt){\n  for(const p of particles){ p.t+=dt; if(p.type!=='ring'){ p.vy+=(p.grav||0)*dt; p.x+=p.vx*dt; p.y+=p.vy*dt; } }\n  particles = particles.filter(p=>p.t<p.life);\n}\nfunction drawParticles(){\n  for(const p of particles){\n    const a = Math.max(0,1-p.t/p.life);\n    ctx.save(); ctx.globalAlpha=a;\n    if(p.type==='ring'){\n      const r = lerp(p.r,p.maxr,p.t/p.life);\n      ctx.strokeStyle=p.color; ctx.lineWidth=p.lw; ctx.beginPath(); ctx.arc(p.x,p.y,r,0,Math.PI*2); ctx.stroke();\n    } else {\n      ctx.fillStyle=p.color; ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill();\n    }\n    ctx.restore();\n  }\n}\nfunction spawnSwish(x,y,big){\n  particles.push({type:'ring',x,y,r:RIM_R*0.6,maxr:RIM_R*(big?2.2:1.7),life:0.5,color:big?COL.gold:COL.cyan,lw:5});\n  const n = big?22:14;\n  for(let i=0;i<n;i++){ const a=Math.random()*Math.PI*2, sp=120+Math.random()*220;\n    particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-80,grav:520,life:0.6+Math.random()*0.4,color:Math.random()<0.5?COL.gold:'#fff',size:2+Math.random()*3}); }\n}\nfunction spawnRimDust(x,y){ for(let i=0;i<8;i++){ const a=Math.PI*(0.8+Math.random()*1.4), sp=60+Math.random()*120;\n  particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,grav:400,life:0.5,color:'rgba(180,180,190,.9)',size:2+Math.random()*2}); } }\nfunction spawnSparks(){ for(let i=0;i<26;i++){ const a=Math.random()*Math.PI*2, sp=140+Math.random()*300;\n  particles.push({x:hoopX+(Math.random()*BB_W-BB_W/2)*0.5,y:BB_TOP+Math.random()*BB_H*0.6,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,grav:300,life:0.5+Math.random()*0.4,color:Math.random()<0.5?COL.cyan:'#fff',size:2+Math.random()*3}); } }\nfunction boltSeg(x1,y1,x2,y2,d,pts){\n  if(d<6){ pts.push({x:x2,y:y2}); return; }\n  const mx=(x1+x2)/2+(Math.random()-0.5)*d, my=(y1+y2)/2+(Math.random()-0.5)*d;\n  boltSeg(x1,y1,mx,my,d/2,pts); boltSeg(mx,my,x2,y2,d/2,pts);\n}\nfunction spawnBolts(){\n  for(let i=0;i<6;i++){\n    const sx = Math.random()<0.5?0:W, sy = Math.random()*180+40;\n    const ex = hoopX+(Math.random()*BB_W-BB_W/2)*0.6, ey = BB_TOP+Math.random()*BB_H*0.6;\n    const pts=[{x:sx,y:sy}]; boltSeg(sx,sy,ex,ey,120,pts);\n    bolts.push({pts,t:0,life:0.45+Math.random()*0.2,width:2+Math.random()*2});\n  }\n}\nfunction updateBolts(dt){ for(const b of bolts) b.t+=dt; bolts = bolts.filter(b=>b.t<b.life); }\nfunction drawBolts(){\n  for(const b of bolts){\n    const a = Math.max(0,1-b.t/b.life);\n    ctx.save(); ctx.globalAlpha=a; ctx.lineJoin='round'; ctx.lineCap='round';\n    ctx.shadowColor=COL.cyan; ctx.shadowBlur=18; ctx.strokeStyle=COL.cyan; ctx.lineWidth=b.width+3;\n    ctx.beginPath(); ctx.moveTo(b.pts[0].x,b.pts[0].y); for(let i=1;i<b.pts.length;i++) ctx.lineTo(b.pts[i].x,b.pts[i].y); ctx.stroke();\n    ctx.shadowBlur=0; ctx.strokeStyle='#eaffff'; ctx.lineWidth=Math.max(1,b.width-0.5);\n    ctx.beginPath(); ctx.moveTo(b.pts[0].x,b.pts[0].y); for(let i=1;i<b.pts.length;i++) ctx.lineTo(b.pts[i].x,b.pts[i].y); ctx.stroke();\n    ctx.restore();\n  }\n}\nfunction pushTrail(){ trail.push({x:ball.x,y:ball.y,life:1}); if(trail.length>16) trail.shift(); }\nfunction updateTrail(dt){ for(const t of trail) t.life-=dt*3.5; trail = trail.filter(t=>t.life>0); }\nfunction drawTrail(){ for(const t of trail){ ctx.save(); ctx.globalAlpha=t.life*0.5; ctx.fillStyle=COL.fire; ctx.beginPath(); ctx.arc(t.x,t.y,ball.r*0.7*t.life,0,Math.PI*2); ctx.fill(); ctx.restore(); } }\n\n// ---------- game flow ----------\nfunction startGame(){\n  initAudio(); sfxStart();\n  score=0; round=1; shotsInRound=0; streak=0; lives=START_LIVES; onFire=false;\n  pendingGameOver=false; bestIsNew=false;\n  cfg=distanceConfig(1); currentBaseY=cfg.baselineY; targetBaseY=cfg.baselineY;\n  ballPhase=-Math.PI/2; swayPhase=0; hoopX=W/2;\n  callouts=[]; particles=[]; bolts=[]; trail=[]; shot=null;\n  shake=0; flash=0; netWiggle=0;\n  state='playing';\n}\nfunction gameOver(){\n  state='over'; sfxBuzz();\n  if(score>best){ best=score; bestIsNew=true; saveBest(best); }\n}\nfunction shoot(){\n  if(state!=='playing') return;\n  const dx = ball.x - hoopX, adx = Math.abs(dx);\n  let ni=0, nd=1e9;\n  for(let i=0;i<shooters.length;i++){ const d=Math.abs(shooters[i].x-ball.x); if(d<nd){ nd=d; ni=i; } }\n  if(shooters[ni]) shooters[ni].jump = 1;\n  sfxShoot();\n  let result;\n  if(adx<=cfg.perfWin) result='swish';\n  else if(adx<=cfg.makeWin) result='make';\n  else if(adx<=cfg.makeWin+BRICK_BAND) result='brick';\n  else result='airball';\n  shot = makeShotAnim(result, ball.x, ball.y, dx);\n  state='shooting';\n}\nfunction makeShotAnim(result,sx,sy,dx){\n  const a = {result,sx,sy,t:0,phase:0,resolved:false};\n  const rimX=hoopX, rimY=RIM_Y;\n  const baseArc = Math.max(150, (sy-rimY)*0.5 + 110);\n  if(result==='swish'||result==='make'){\n    a.dur=0.6; a.ex=rimX + (result==='make' ? clamp(dx,-cfg.makeWin,cfg.makeWin)*0.25 : 0); a.ey=rimY; a.arc=baseArc+40;\n  } else if(result==='brick'){\n    a.dur=0.5; a.ex=rimX + (dx<0?-1:1)*(RIM_R*0.75); a.ey=rimY-2; a.arc=baseArc+20;\n  } else {\n    a.dur=0.68; const dir=dx<0?-1:1; a.ex=rimX+dir*(RIM_R*2.3+110); a.ey=rimY-30; a.arc=baseArc;\n  }\n  return a;\n}\nfunction updateShot(dt){\n  const a = shot; if(!a) return; a.t+=dt;\n  if(a.result==='brick'){\n    if(a.phase===0){\n      const u=Math.min(1,a.t/a.dur);\n      ball.x=lerp(a.sx,a.ex,u); ball.y=lerp(a.sy,a.ey,u)-a.arc*Math.sin(Math.PI*u);\n      if(u>=1){\n        if(!a.resolved){ resolveShot('brick',a.ex,a.ey); a.resolved=true; }\n        a.phase=1; a.t=0; a.dur=0.55;\n        a.bvx=(a.ex<hoopX?-1:1)*(140+Math.random()*80); a.bvy=-150-Math.random()*60;\n        a.bx=a.ex; a.by=a.ey;\n      }\n    } else {\n      a.bvy+=900*dt; a.bx+=a.bvx*dt; a.by+=a.bvy*dt; ball.x=a.bx; ball.y=a.by;\n      if(a.t>=a.dur) endShot();\n    }\n    return;\n  }\n  const u=Math.min(1,a.t/a.dur);\n  ball.x=lerp(a.sx,a.ex,u); ball.y=lerp(a.sy,a.ey,u)-a.arc*Math.sin(Math.PI*u);\n  if(!a.resolved){\n    if((a.result!=='airball' && u>=0.84) || (a.result==='airball' && u>=0.5)){\n      resolveShot(a.result, a.ex, a.result==='airball'?a.ey:RIM_Y); a.resolved=true;\n    }\n  }\n  if(u>=1) endShot();\n}\nfunction resolveShot(result,x,y){\n  if(result==='swish' || result==='make'){\n    const willStreak = streak+1;\n    const mult = willStreak>=3 ? 2 : 1;\n    let pts = cfg.base + (result==='swish'?2:0);\n    pts *= mult;\n    score += pts;\n    streak = willStreak; onFire = streak>=3;\n    netWiggle = 1;\n    spawnSwish(x,y,result==='swish');\n    const txt = result==='swish'\n      ? pick(['SWISH!','NOTHING BUT NET!','WET!','BULLSEYE!','CASH!'])\n      : pick(['BUCKET!','COUNT IT!','GOT IT!','NICE!','AND ONE!','DRAINED IT!']);\n    addCallout(txt, x, RIM_Y-34, result==='swish'?COL.gold:COL.green, {size: result==='swish'?64:56, life:1.0});\n    addCallout('+'+pts, x, RIM_Y-92, COL.gold, {size:40,life:0.9,vy:-50});\n    if(result==='swish') sfxSwish(); else sfxMake();\n    if(streak%3===0) triggerLightning();\n  } else {\n    streak=0; onFire=false; lives--;\n    shake=Math.max(shake,11);\n    if(result==='brick'){ addCallout(pick(['BRICK!','CLANK!','OFF THE IRON!','NO GOOD!','RIM OUT!']), x, RIM_Y-10, COL.red, {size:58,life:1.0}); spawnRimDust(x,y); sfxBrick(); }\n    else { addCallout(pick(['AIRBALL!','WAY OFF!','NOTHING BUT AIR!','OVERSHOT!','WIDE!']), x, RIM_Y-30, '#ff8a3c', {size:56,life:1.0}); sfxAir(); }\n    if(lives<=0) pendingGameOver=true;\n  }\n}\nfunction triggerLightning(){\n  flash=1; shake=Math.max(shake,16);\n  spawnBolts(); spawnSparks();\n  const bonus = 10 + 5*round;\n  score += bonus;\n  const gotLife = lives<MAX_LIVES; if(gotLife) lives++;\n  addCallout(pick(['LIGHTNING!','ELECTRIC!','HEAT CHECK!','ON FIRE!','THUNDER!']), W/2, BB_TOP+BB_H+40, COL.cyan, {size:62,life:1.4});\n  addCallout('+'+bonus+(gotLife?'   +1 BALL':''), W/2, BB_TOP+BB_H+100, COL.gold, {size:38,life:1.4,vy:-12});\n  sfxLight(); sfxBonus();\n}\nfunction endShot(){\n  shot=null; shotsInRound++;\n  if(pendingGameOver){ pendingGameOver=false; gameOver(); return; }\n  if(shotsInRound>=SHOTS_PER_ROUND){\n    round++; shotsInRound=0;\n    cfg=distanceConfig(round); targetBaseY=cfg.baselineY;\n    addCallout('BACK IT UP', W/2, Math.min(currentBaseY-150, H-200), '#fff', {size:46,life:1.1});\n    addCallout(cfg.name+'!', W/2, RIM_Y+86, COL.cyan, {size:50,life:1.5,vy:-8});\n    sfxStep();\n  }\n  ballPhase=-Math.PI/2; // restart sweep from the left → reads left-to-right across the shooters\n  state='playing';\n}\n\n// ---------- update ----------\nfunction update(dt){\n  shake     = Math.max(0, shake-dt*60);\n  flash     = Math.max(0, flash-dt*2.2);\n  netWiggle = Math.max(0, netWiggle-dt*3.2);\n  updateCallouts(dt); updateParticles(dt); updateBolts(dt); updateTrail(dt);\n  currentBaseY += (targetBaseY-currentBaseY)*Math.min(1,dt*8);\n  for(const s of shooters){ s.bob+=dt*3; s.jump=Math.max(0,s.jump-dt*2.2); }\n\n  if(state==='menu' || state==='over'){\n    ballPhase += dt*1.1;\n    ball.x = W/2 + AMP*Math.sin(ballPhase); ball.y = currentBaseY-86;\n    return;\n  }\n  swayPhase += dt*1.6; hoopX = W/2 + cfg.sway*Math.sin(swayPhase);\n  if(onFire && (state==='playing'||state==='shooting')) pushTrail();\n  if(state==='playing'){\n    ballPhase += dt*(Math.PI*2/cfg.period);\n    ball.x = W/2 + AMP*Math.sin(ballPhase); ball.y = currentBaseY-86;\n  } else if(state==='shooting'){\n    updateShot(dt);\n  }\n}\n\n// ---------- static background ----------\nfunction drawCrowd(){\n  const c=bgx; c.save();\n  for(const side of [0,1]){\n    const x0 = side===0 ? 0 : W-150, x1 = side===0 ? 150 : W;\n    c.fillStyle='rgba(10,14,30,.6)'; c.fillRect(x0,120,x1-x0,200);\n    const cols=['#28406e','#3a2c5a','#553a2a','#214a3a','#4a2438'];\n    for(let yy=140; yy<310; yy+=16){\n      for(let xx=x0+8; xx<x1-6; xx+=14){\n        if(Math.random()<0.5) continue;\n        c.fillStyle=cols[(Math.random()*cols.length)|0]; c.globalAlpha=0.5; c.fillRect(xx,yy,7,7);\n      }\n    }\n  }\n  c.restore();\n}\nfunction drawPaint(topY){\n  const c=bgx;\n  const ltop=topY+2, lbot=topY+250, ltH=46, lbH=80;\n  c.beginPath(); c.moveTo(W/2-ltH,ltop); c.lineTo(W/2+ltH,ltop); c.lineTo(W/2+lbH,lbot); c.lineTo(W/2-lbH,lbot); c.closePath();\n  c.fillStyle='rgba(40,80,170,.55)'; c.fill();\n  c.strokeStyle='rgba(245,241,230,.7)'; c.lineWidth=3; c.stroke();\n  c.beginPath(); c.moveTo(W/2-lbH,lbot); c.lineTo(W/2+lbH,lbot); c.stroke();\n  c.beginPath(); c.ellipse(W/2,lbot,lbH*0.9,26,0,0,Math.PI*2); c.stroke();\n}\nfunction drawFloor(){\n  const c=bgx;\n  const topY=362, topHalf=150, botY=H, botHalf=W/2+40;\n  c.beginPath(); c.moveTo(W/2-topHalf,topY); c.lineTo(W/2+topHalf,topY); c.lineTo(W/2+botHalf,botY); c.lineTo(W/2-botHalf,botY); c.closePath();\n  const g=c.createLinearGradient(0,topY,0,botY); g.addColorStop(0,COL.woodTop); g.addColorStop(1,COL.woodBot);\n  c.fillStyle=g; c.fill();\n  c.strokeStyle=COL.woodLine; c.lineWidth=2;\n  const strips=12;\n  for(let i=0;i<=strips;i++){\n    const tX=lerp(W/2-topHalf,W/2+topHalf,i/strips), bX=lerp(W/2-botHalf,W/2+botHalf,i/strips);\n    c.beginPath(); c.moveTo(tX,topY); c.lineTo(bX,botY); c.stroke();\n  }\n  drawPaint(topY);\n  c.strokeStyle=COL.line; c.lineWidth=4;\n  c.beginPath(); c.moveTo(W/2-topHalf,topY); c.lineTo(W/2+topHalf,topY); c.stroke();\n}\nfunction renderBG(){\n  const c=bgx;\n  let g=c.createLinearGradient(0,0,0,H); g.addColorStop(0,COL.bgTop); g.addColorStop(0.5,'#070a18'); g.addColorStop(1,COL.bgBot);\n  c.fillStyle=g; c.fillRect(0,0,W,H);\n  g=c.createRadialGradient(W/2,RIM_Y,30,W/2,RIM_Y,420); g.addColorStop(0,'rgba(27,212,255,.18)'); g.addColorStop(1,'rgba(27,212,255,0)');\n  c.fillStyle=g; c.fillRect(0,0,W,H);\n  for(let i=0;i<5;i++){\n    const x=(i+0.5)*(W/5);\n    const gl=c.createRadialGradient(x,30,2,x,30,60); gl.addColorStop(0,'rgba(255,255,255,.5)'); gl.addColorStop(1,'rgba(255,255,255,0)');\n    c.fillStyle=gl; c.beginPath(); c.arc(x,30,60,0,Math.PI*2); c.fill();\n    c.fillStyle='rgba(255,255,255,.85)'; c.beginPath(); c.arc(x,30,4,0,Math.PI*2); c.fill();\n  }\n  drawCrowd();\n  drawFloor();\n  g=c.createRadialGradient(W/2,H*0.55,H*0.3,W/2,H*0.55,H*0.72); g.addColorStop(0,'rgba(0,0,0,0)'); g.addColorStop(1,'rgba(0,0,0,.45)');\n  c.fillStyle=g; c.fillRect(0,0,W,H);\n}\n\n// ---------- dynamic drawing ----------\nfunction drawAimBeam(){\n  const topY=RIM_Y+10, botY=currentBaseY-10;\n  const g=ctx.createLinearGradient(0,topY,0,botY);\n  g.addColorStop(0,'rgba(124,220,255,0)'); g.addColorStop(0.15,'rgba(124,220,255,.10)'); g.addColorStop(1,'rgba(124,220,255,0)');\n  ctx.fillStyle=g; ctx.fillRect(hoopX-cfg.makeWin, topY, cfg.makeWin*2, botY-topY);\n  ctx.strokeStyle='rgba(124,220,255,.5)'; ctx.lineWidth=2; ctx.setLineDash([8,10]);\n  ctx.beginPath(); ctx.moveTo(hoopX,topY); ctx.lineTo(hoopX,botY); ctx.stroke(); ctx.setLineDash([]);\n  ctx.fillStyle='rgba(124,220,255,.25)'; ctx.beginPath(); ctx.ellipse(hoopX,botY,cfg.makeWin*0.9,10,0,0,Math.PI*2); ctx.fill();\n}\nfunction drawNet(bx,ry){\n  const topR=RIM_R-4, botR=18, n=10;\n  const sway=Math.sin(performance.now()/120)*2*(1-netWiggle), droop=netWiggle*22;\n  ctx.strokeStyle=COL.net; ctx.lineWidth=2;\n  for(let i=0;i<=n;i++){\n    const ang=(i/n)*Math.PI*2;\n    const tx=bx+Math.cos(ang)*topR, tz=Math.sin(ang)*topR*0.26, ty=ry+tz*0.5;\n    const bxp=bx+Math.cos(ang)*botR+sway, by=ry+NET_DEPTH+droop;\n    ctx.beginPath(); ctx.moveTo(tx,ty); ctx.quadraticCurveTo((tx+bxp)/2, ry+NET_DEPTH*0.5, bxp, by); ctx.stroke();\n  }\n  for(let k=1;k<=2;k++){\n    const yy=ry+(NET_DEPTH*k/3)+droop*k/3, r2=topR-(topR-botR)*(k/3);\n    ctx.beginPath(); ctx.ellipse(bx,yy,r2,r2*0.22,0,0,Math.PI*2); ctx.stroke();\n  }\n}\nfunction drawHoop(){\n  const bx=hoopX, hot = onFire || flash>0.05;\n  ctx.strokeStyle='#39435f'; ctx.lineWidth=14; ctx.lineCap='round';\n  ctx.beginPath(); ctx.moveTo(bx, BB_TOP+BB_H*0.4); ctx.lineTo(bx, BB_TOP-40); ctx.stroke();\n  ctx.save();\n  if(hot){ ctx.shadowColor=COL.cyan; ctx.shadowBlur=30; }\n  rr(ctx, bx-BB_W/2, BB_TOP, BB_W, BB_H, 14);\n  const bgrad=ctx.createLinearGradient(0,BB_TOP,0,BB_TOP+BB_H);\n  bgrad.addColorStop(0,'rgba(238,243,255,.92)'); bgrad.addColorStop(1,'rgba(210,222,250,.86)');\n  ctx.fillStyle=bgrad; ctx.fill(); ctx.shadowBlur=0;\n  ctx.lineWidth=6; ctx.strokeStyle=COL.boardEdge; rr(ctx, bx-BB_W/2, BB_TOP, BB_W, BB_H, 14); ctx.stroke();\n  ctx.restore();\n  const sqW=120, sqH=88, sqx=bx-sqW/2, sqy=BB_TOP+BB_H-118;\n  ctx.lineWidth=8;\n  const pulse = hot ? (0.6+0.4*Math.sin(performance.now()/80)) : 1;\n  ctx.strokeStyle = hot?COL.cyan:COL.target; ctx.globalAlpha=hot?pulse:1;\n  rr(ctx, sqx, sqy, sqW, sqH, 4); ctx.stroke(); ctx.globalAlpha=1;\n  ctx.fillStyle=COL.rimDark; ctx.fillRect(bx-8, BB_TOP+BB_H-22, 16, 16);\n  ctx.lineWidth=9; ctx.strokeStyle=COL.rim;\n  ctx.beginPath(); ctx.ellipse(bx, RIM_Y, RIM_R, 15, 0, 0, Math.PI*2); ctx.stroke();\n  ctx.beginPath(); ctx.ellipse(bx, RIM_Y, RIM_R, 15, 0, 0, Math.PI); ctx.stroke();\n  drawNet(bx, RIM_Y);\n}\nfunction drawShooter(s){\n  const baseY=currentBaseY;\n  const jp=Math.min(1,s.jump);\n  const lift=Math.sin(Math.PI*jp)*70;\n  const bob=Math.sin(s.bob)*3*(1-jp);\n  const y=baseY-lift+bob, x=s.x, jumping=s.jump>0.05;\n  ctx.save(); ctx.fillStyle='rgba(0,0,0,.28)';\n  ctx.beginPath(); ctx.ellipse(x, baseY+6, 26-lift*0.12, 8-lift*0.03, 0,0,Math.PI*2); ctx.fill(); ctx.restore();\n  ctx.strokeStyle='#23304d'; ctx.lineWidth=9; ctx.lineCap='round';\n  ctx.beginPath(); ctx.moveTo(x-7,y-2); ctx.lineTo(x-10,y+34); ctx.stroke();\n  ctx.beginPath(); ctx.moveTo(x+7,y-2); ctx.lineTo(x+10,y+34); ctx.stroke();\n  rr(ctx, x-16, y-44, 32, 46, 10); ctx.fillStyle=s.jersey; ctx.fill();\n  ctx.strokeStyle=s.jersey; ctx.lineWidth=8;\n  if(jumping){\n    ctx.beginPath(); ctx.moveTo(x-12,y-36); ctx.lineTo(x-20,y-66); ctx.stroke();\n    ctx.beginPath(); ctx.moveTo(x+12,y-36); ctx.lineTo(x+20,y-66); ctx.stroke();\n    ctx.fillStyle='#e7b487';\n    ctx.beginPath(); ctx.arc(x-21,y-68,5,0,Math.PI*2); ctx.fill();\n    ctx.beginPath(); ctx.arc(x+21,y-68,5,0,Math.PI*2); ctx.fill();\n  } else {\n    ctx.beginPath(); ctx.moveTo(x-12,y-36); ctx.lineTo(x-20,y-12); ctx.stroke();\n    ctx.beginPath(); ctx.moveTo(x+12,y-36); ctx.lineTo(x+20,y-12); ctx.stroke();\n    ctx.fillStyle='#e7b487';\n    ctx.beginPath(); ctx.arc(x-21,y-10,5,0,Math.PI*2); ctx.fill();\n    ctx.beginPath(); ctx.arc(x+21,y-10,5,0,Math.PI*2); ctx.fill();\n  }\n  ctx.fillStyle='#e7b487'; ctx.beginPath(); ctx.arc(x, y-58, 12, 0, Math.PI*2); ctx.fill();\n  ctx.fillStyle='#2a2118'; ctx.beginPath(); ctx.arc(x, y-62, 12, Math.PI*1.05, Math.PI*1.95); ctx.fill();\n}\nfunction drawBall(x,y,r,glow){\n  ctx.save();\n  const g=ctx.createRadialGradient(x-r*0.3,y-r*0