          "language": "html",
          "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>BASSLINE — Route the Rave</title>\n<style>\n  :root{\n    --bg:#0a0712;\n    --bg2:#12091f;\n    --panel:rgba(22,12,38,0.72);\n    --panel-edge:rgba(160,107,255,0.35);\n    --ink:#f3ecff;\n    --ink-dim:#a99cc4;\n    --mag:#ff3d9a;\n    --cyan:#36e2ff;\n    --lime:#b6ff3b;\n    --purp:#a06bff;\n    --amber:#ffb13b;\n    --red:#ff5a5a;\n    --mono:\"SFMono-Regular\",Consolas,\"Liberation Mono\",Menlo,monospace;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    font-family:-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    color:var(--ink);\n    background:\n      radial-gradient(900px 520px at 18% -8%, rgba(255,61,154,0.18), transparent 60%),\n      radial-gradient(820px 520px at 92% 4%, rgba(54,226,255,0.16), transparent 60%),\n      radial-gradient(900px 700px at 50% 120%, rgba(160,107,255,0.20), transparent 60%),\n      linear-gradient(160deg, var(--bg), var(--bg2));\n    min-height:100vh;\n    padding:22px 16px 60px;\n  }\n  .wrap{max-width:1000px;margin:0 auto;}\n  header.top{text-align:center;margin-bottom:14px;}\n  h1{\n    margin:0;\n    font-size:38px;\n    font-weight:900;\n    line-height:1.02;\n    background:linear-gradient(92deg,var(--mag),var(--amber) 40%,var(--lime) 70%,var(--cyan));\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n    text-shadow:0 0 26px rgba(255,61,154,0.25);\n  }\n  .tag{color:var(--ink-dim);font-size:14px;margin-top:6px;}\n  .how{\n    color:var(--ink-dim);font-size:12.5px;margin:8px auto 0;max-width:680px;line-height:1.5;\n  }\n  .how b{color:var(--ink);}\n\n  .meters{\n    display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0 14px;\n  }\n  .meter{\n    background:var(--panel);border:1px solid var(--panel-edge);border-radius:14px;\n    padding:10px 12px;backdrop-filter:blur(6px);\n  }\n  .meter .lab{font-size:11px;color:var(--ink-dim);text-transform:uppercase;}\n  .meter .val{font-size:21px;font-weight:800;margin:2px 0 7px;}\n  .track{height:9px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden;}\n  .fill{height:100%;width:0%;border-radius:6px;transition:width .45s ease;}\n\n  .stage-wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:14px;}\n  @media (max-width:780px){ .stage-wrap{grid-template-columns:1fr;} .meters{grid-template-columns:repeat(2,1fr);} h1{font-size:30px;} }\n\n  .card{\n    background:var(--panel);border:1px solid var(--panel-edge);border-radius:16px;\n    padding:14px;backdrop-filter:blur(6px);\n  }\n  canvas#map{width:100%;height:auto;max-width:620px;display:block;margin:0 auto;border-radius:12px;}\n  .maphint{text-align:center;color:var(--ink-dim);font-size:11.5px;margin-top:8px;}\n\n  .blockhead{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:10px;}\n  .blockhead .time{font-size:22px;font-weight:900;}\n  .blockhead .of{font-size:12px;color:var(--ink-dim);}\n\n  .acts{display:flex;flex-direction:column;gap:9px;}\n  .act{\n    text-align:left;width:100%;cursor:pointer;color:var(--ink);\n    background:rgba(255,255,255,0.03);\n    border:1px solid rgba(255,255,255,0.10);\n    border-left-width:5px;border-radius:12px;padding:10px 12px;\n    transition:transform .12s ease, box-shadow .18s ease, background .18s ease;\n    font:inherit;\n  }\n  .act:hover{transform:translateY(-2px);background:rgba(255,255,255,0.06);}\n  .act:focus-visible{outline:2px solid var(--cyan);outline-offset:2px;}\n  .act .nm{font-size:16px;font-weight:800;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}\n  .act .vibe{font-size:12.5px;color:var(--ink-dim);margin:3px 0 7px;}\n  .act .row{display:flex;align-items:center;gap:12px;font-size:11.5px;flex-wrap:wrap;}\n  .stage-dot{width:9px;height:9px;border-radius:50%;display:inline-block;}\n  .cost{color:var(--ink-dim);}\n  .cost b{color:var(--ink);font-weight:700;}\n  .badge{font-size:10.5px;font-weight:800;padding:2px 7px;border-radius:999px;}\n  .badge.must{background:rgba(255,177,59,0.18);color:var(--amber);border:1px solid rgba(255,177,59,0.5);}\n  .badge.crew{background:rgba(54,226,255,0.16);color:var(--cyan);border:1px solid rgba(54,226,255,0.45);}\n\n  .rest{\n    margin-top:11px;width:100%;cursor:pointer;font:inherit;color:var(--ink);\n    background:rgba(160,107,255,0.12);border:1px dashed rgba(160,107,255,0.55);\n    border-radius:12px;padding:10px 12px;transition:background .18s ease;\n  }\n  .rest:hover{background:rgba(160,107,255,0.22);}\n  .rest .t{font-weight:800;font-size:14px;}\n  .rest .s{font-size:11.5px;color:var(--ink-dim);margin-top:2px;}\n\n  #status{\n    min-height:20px;text-align:center;font-size:13.5px;font-weight:700;margin:12px 0 4px;\n    color:var(--lime);transition:opacity .2s ease;\n  }\n\n  .route{margin-top:6px;}\n  .route .lab{font-size:11px;color:var(--ink-dim);text-transform:uppercase;margin-bottom:7px;}\n  .chips{display:flex;flex-wrap:wrap;gap:7px;}\n  .chip{\n    font-size:11.5px;border-radius:999px;padding:4px 10px;\n    background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);\n    display:flex;align-items:center;gap:6px;\n  }\n  .chip .ct{color:var(--ink-dim);font-weight:700;}\n  .chip.skip{border-style:dashed;color:var(--ink-dim);}\n\n  /* results */\n  #results{display:none;}\n  .scoreBig{font-size:54px;font-weight:900;line-height:1;\n    background:linear-gradient(92deg,var(--lime),var(--cyan));\n    -webkit-background-clip:text;background-clip:text;color:transparent;}\n  .grade{font-size:18px;font-weight:900;margin-top:4px;}\n  .verdict{color:var(--ink-dim);font-size:13.5px;margin:6px 0 14px;line-height:1.5;}\n  .bd{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}\n  .bdrow{display:flex;justify-content:space-between;font-size:13.5px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:5px;}\n  .bdrow b{font-weight:800;}\n  textarea#export{\n    width:100%;min-height:184px;resize:vertical;border-radius:12px;\n    background:rgba(0,0,0,0.35);color:var(--ink);border:1px solid var(--panel-edge);\n    padding:11px;font-family:var(--mono);font-size:12.5px;line-height:1.5;\n  }\n  .btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;}\n  button.action{\n    cursor:pointer;font:inherit;font-weight:800;font-size:14px;color:#0a0712;\n    border:none;border-radius:11px;padding:11px 18px;transition:transform .12s ease, filter .18s ease;\n  }\n  button.action:hover{transform:translateY(-2px);filter:brightness(1.08);}\n  button.action:focus-visible{outline:2px solid var(--ink);outline-offset:2px;}\n  .b-copy{background:linear-gradient(92deg,var(--lime),#7be000);}\n  .b-dl{background:linear-gradient(92deg,var(--cyan),#00b7e6);}\n  .b-reset{background:linear-gradient(92deg,var(--mag),#ff7ac0);}\n  .ghost{\n    cursor:pointer;font:inherit;font-weight:800;font-size:14px;\n    background:transparent;color:var(--ink);border:1px solid var(--panel-edge);\n    border-radius:11px;padding:11px 18px;\n  }\n  .ghost:hover{background:rgba(255,255,255,0.05);}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header class=\"top\">\n    <h1>BASSLINE</h1>\n    <div class=\"tag\">Route the rave — one festival day, five stages, zero do-overs.</div>\n    <p class=\"how\">\n      Every slot, sets overlap. Pick <b>one</b> act or sit it out. Chasing <b>★ must-sees</b> scores big,\n      but the <b>👥 crew</b> wanders off to its own picks, far stages drain <b>energy</b> and rack up <b>steps</b>.\n      Plan the day, then copy or download your route.\n    </p>\n  </header>\n\n  <section class=\"meters\" aria-label=\"status meters\">\n    <div class=\"meter\">\n      <div class=\"lab\">Energy</div>\n      <div class=\"val\"><span id=\"energyVal\">100</span>/100</div>\n      <div class=\"track\"><div class=\"fill\" id=\"energyBar\"></div></div>\n    </div>\n    <div class=\"meter\">\n      <div class=\"lab\">Crew loyalty</div>\n      <div class=\"val\"><span id=\"loyaltyVal\">75</span>/100</div>\n      <div class=\"track\"><div class=\"fill\" id=\"loyaltyBar\"></div></div>\n    </div>\n    <div class=\"meter\">\n      <div class=\"lab\">Must-sees</div>\n      <div class=\"val\"><span id=\"mustVal\">0</span>/4</div>\n      <div class=\"track\"><div class=\"fill\" id=\"mustBar\"></div></div>\n    </div>\n    <div class=\"meter\">\n      <div class=\"lab\">Steps walked</div>\n      <div class=\"val\" id=\"stepsVal\">0</div>\n      <div class=\"track\"><div class=\"fill\" id=\"stepsBar\" style=\"width:0%;background:linear-gradient(90deg,#7a6,#cfa);\"></div></div>\n    </div>\n  </section>\n\n  <div class=\"stage-wrap\">\n    <div class=\"card\">\n      <canvas id=\"map\" width=\"620\" height=\"380\"></canvas>\n      <div class=\"maphint\">Your path lights up as you go. Pulsing rings = this slot's options.</div>\n    </div>\n    <div class=\"card\">\n      <div id=\"blockPanel\"></div>\n      <div id=\"results\"></div>\n    </div>\n  </div>\n\n  <div id=\"status\"></div>\n\n  <div class=\"route card\">\n    <div class=\"lab\">Your route so far</div>\n    <div class=\"chips\" id=\"routeRow\"></div>\n  </div>\n</div>\n\n<script>\n(function(){\n  \"use strict\";\n\n  /* ---------- data ---------- */\n  var W = 620, H = 380;\n\n  var STAGES = {\n    \"Entrance\":       { x:310, y:352, color:\"#cccccc\", energy:0  },\n    \"Leviathan\":      { x:310, y:66,  color:\"#ff3d9a\", energy:13 },\n    \"Honeycomb\":      { x:86,  y:196, color:\"#b6ff3b\", energy:10 },\n    \"The Trench\":     { x:540, y:248, color:\"#36e2ff\", energy:16 },\n    \"The Glade\":      { x:196, y:300, color:\"#a06bff\", energy:6  },\n    \"Sunrise Temple\": { x:540, y:84,  color:\"#ffb13b\", energy:12 }\n  };\n\n  var BLOCKS = [\n    { time:\"4:00 PM\", acts:[\n      { id:\"a1\", name:\"Bass Cadet\",        stage:\"Leviathan\",  vibe:\"Epic opening anthem to start the day right.\", must:true,  crew:false },\n      { id:\"a2\", name:\"Gummy Bass\",        stage:\"Honeycomb\",  vibe:\"Gooey melodic wobbles, an easy warmup.\",       must:false, crew:true  },\n      { id:\"a3\", name:\"Drift Reptile\",     stage:\"The Glade\",  vibe:\"Slow downtempo to ease into the grounds.\",     must:false, crew:false }\n    ]},\n    { time:\"5:30 PM\", acts:[\n      { id:\"a4\", name:\"Mantis Step\",       stage:\"The Trench\", vibe:\"Early heavy stomp for the brave.\",             must:false, crew:false },\n      { id:\"a5\", name:\"Lunar Tide\",        stage:\"Honeycomb\",  vibe:\"Shimmering future-bass float.\",                must:false, crew:true  },\n      { id:\"a6\", name:\"Crystal Toad\",      stage:\"The Glade\",  vibe:\"Wonky glitch grooves, low effort.\",            must:false, crew:false }\n    ]},\n    { time:\"7:00 PM\", acts:[\n      { id:\"a7\", name:\"Subwoofer Sermon\",  stage:\"The Trench\", vibe:\"The preacher of filth. You came for this.\",    must:true,  crew:false },\n      { id:\"a8\", name:\"Velvet Sasquatch\",  stage:\"Leviathan\",  vibe:\"Big crowd singalong, crew's hyped.\",           must:false, crew:true  },\n      { id:\"a9\", name:\"Mothlight\",         stage:\"The Glade\",  vibe:\"Dreamy downtempo to catch your breath.\",       must:false, crew:false }\n    ]},\n    { time:\"8:30 PM\", acts:[\n      { id:\"a10\", name:\"Gravity Worm\",     stage:\"The Trench\", vibe:\"Crushing low-end. Crew's diving in.\",          must:false, crew:true  },\n      { id:\"a11\", name:\"Polychrome\",       stage:\"Honeycomb\",  vibe:\"Color-drenched melodic set.\",                  must:false, crew:false },\n      { id:\"a12\", name:\"Cosmic Catfish\",   stage:\"The Glade\",  vibe:\"Wonky bottom-feeder funk. Secretly elite.\",    must:true,  crew:false }\n    ]},\n    { time:\"10:00 PM\", acts:[\n      { id:\"a13\", name:\"Neon Yeti\",        stage:\"Leviathan\",  vibe:\"The headliner. Everyone is here.\",             must:true,  crew:true  },\n      { id:\"a14\", name:\"Hydraulic Press\",  stage:\"The Trench\", vibe:\"Maximum-pressure dubstep.\",                    must:false, crew:false },\n      { id:\"a15\", name:\"Glacial Funk\",     stage:\"Honeycomb\",  vibe:\"A cool melodic breather.\",                     must:false, crew:false }\n    ]},\n    { time:\"11:30 PM\", acts:[\n      { id:\"a16\", name:\"The Bog Wizard\",   stage:\"Sunrise Temple\", vibe:\"Psychedelic late-night ritual. Crew's call.\", must:false, crew:true  },\n      { id:\"a17\", name:\"Tidal Mecha\",      stage:\"The Trench\",     vibe:\"The heavy closer.\",                           must:false, crew:false },\n      { id:\"a18\", name:\"Static Monk\",      stage:\"The Glade\",      vibe:\"Downtempo wind-down to float home.\",          must:false, crew:false }\n    ]}\n  ];\n\n  var TOTAL_MUST = 4;\n  var WALK_ENERGY = 0.04;   /* energy per logical pixel */\n  var STEP_FACTOR = 1.7;    /* flavour \"steps\" per pixel */\n  var REST_ENERGY = 26;\n\n  /* ---------- state ---------- */\n  var state;\n  function freshState(){\n    return {\n      idx:0,\n      energy:100,\n      loyalty:75,\n      caught:0,\n      steps:0,\n      at:\"Entrance\",\n      route:[],          /* {time, label, stage|null, must, crew, skipped} */\n      visited:{},\n      finished:false\n    };\n  }\n\n  /* ---------- helpers ---------- */\n  function dist(aName,bName){\n    var a=STAGES[aName], b=STAGES[bName];\n    return Math.sqrt((a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y));\n  }\n  function bound(v,lo,hi){ return v<lo?lo:(v>hi?hi:v); }\n  function clear(node){ while(node.firstChild){ node.removeChild(node.firstChild); } }\n  function fmt(n){ return String(Math.round(n)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"); }\n\n  var $ = function(id){ return document.getElementById(id); };\n\n  /* ---------- meters ---------- */\n  function colorForEnergy(v){\n    if(v<25) return \"linear-gradient(90deg,#ff5a5a,#ff9a5a)\";\n    if(v<55) return \"linear-gradient(90deg,#ffb13b,#ffe07a)\";\n    return \"linear-gradient(90deg,#36e2ff,#b6ff3b)\";\n  }\n  function renderMeters(){\n    $(\"energyVal\").textContent = String(Math.round(state.energy));\n    $(\"energyBar\").style.width = bound(state.energy,0,100) + \"%\";\n    $(\"energyBar\").style.background = colorForEnergy(state.energy);\n\n    $(\"loyaltyVal\").textContent = String(Math.round(state.loyalty));\n    $(\"loyaltyBar\").style.width = bound(state.loyalty,0,100) + \"%\";\n    $(\"loyaltyBar\").style.background = \"linear-gradient(90deg,#36e2ff,#a06bff)\";\n\n    $(\"mustVal\").textContent = String(state.caught);\n    $(\"mustBar\").style.width = (state.caught/TOTAL_MUST*100) + \"%\";\n    $(\"mustBar\").style.background = \"linear-gradient(90deg,#ffb13b,#ff3d9a)\";\n\n    $(\"stepsVal\").textContent = fmt(state.steps);\n    var stepPct = bound(state.steps/4200*100,0,100);\n    $(\"stepsBar\").style.width = stepPct + \"%\";\n  }\n\n  /* ---------- status ---------- */\n  function setStatus(msg,color){\n    var s=$(\"status\");\n    s.textContent=msg;\n    s.style.color=color||\"var(--lime)\";\n  }\n\n  /* ---------- block panel ---------- */\n  function makeBadge(text,cls){\n    var b=document.createElement(\"span\");\n    b.className=\"badge \"+cls;\n    b.textContent=text;\n    return b;\n  }\n\n  function renderBlock(){\n    var panel=$(\"blockPanel\");\n    clear(panel);\n    if(state.finished){ panel.style.display=\"none\"; return; }\n    panel.style.display=\"block\";\n\n    var block=BLOCKS[state.idx];\n\n    var head=document.createElement(\"div\");\n    head.className=\"blockhead\";\n    var t=document.createElement(\"div\"); t.className=\"time\"; t.textContent=block.time;\n    var of=document.createElement(\"div\"); of.className=\"of\"; of.textContent=\"Slot \"+(state.idx+1)+\" of \"+BLOCKS.length;\n    head.appendChild(t); head.appendChild(of);\n    panel.appendChild(head);\n\n    var list=document.createElement(\"div\");\n    list.className=\"acts\";\n\n    block.acts.forEach(function(act){\n      var d=dist(state.at, act.stage);\n      var eCost=Math.round(STAGES[act.stage].energy + d*WALK_ENERGY);\n      var steps=Math.round(d*STEP_FACTOR);\n      var st=STAGES[act.stage];\n\n      var btn=document.createElement(\"button\");\n      btn.type=\"button\";\n      btn.className=\"act\";\n      btn.style.borderLeftColor=st.color;\n\n      var nm=document.createElement(\"div\"); nm.className=\"nm\";\n      var nmText=document.createElement(\"span\"); nmText.textContent=act.name;\n      nm.appendChild(nmText);\n      if(act.must) nm.appendChild(makeBadge(\"★ MUST-SEE\",\"must\"));\n      if(act.crew) nm.appendChild(makeBadge(\"👥 CREW\",\"crew\"));\n      btn.appendChild(nm);\n\n      var vibe=document.createElement(\"div\"); vibe.className=\"vibe\"; vibe.textContent=act.vibe;\n      btn.appendChild(vibe);\n\n      var row=document.createElement(\"div\"); row.className=\"row\";\n      var stg=document.createElement(\"span\");\n      var dot=document.createElement(\"span\"); dot.className=\"stage-dot\"; dot.style.background=st.color;\n      stg.appendChild(dot);\n      var stgName=document.createElement(\"span\"); stgName.textContent=\" \"+act.stage;\n      stg.appendChild(stgName);\n      stg.style.display=\"flex\"; stg.style.alignItems=\"center\"; stg.style.gap=\"5px\";\n      row.appendChild(stg);\n\n      var cost=document.createElement(\"span\"); cost.className=\"cost\";\n      var ce=document.createElement(\"b\"); ce.textContent=\"-\"+eCost;\n      cost.appendChild(document.createTextNode(\"⚡ \"));\n      cost.appendChild(ce);\n      cost.appendChild(document.createTextNode(\" energy\"));\n      row.appendChild(cost);\n\n      var cost2=document.createElement(\"span\"); cost2.className=\"cost\";\n      var cs=document.createElement(\"b\"); cs.textContent=fmt(steps);\n      cost2.appendChild(document.createTextNode(\"👟 +\"));\n      cost2.appendChild(cs);\n      cost2.appendChild(document.createTextNode(\" steps\"));\n      row.appendChild(cost2);\n\n      btn.appendChild(row);\n\n      btn.addEventListener(\"click\", function(){ chooseAct(act, eCost, steps); });\n      list.appendChild(btn);\n    });\n\n    panel.appendChild(list);\n\n    var rest=document.createElement(\"button\");\n    rest.type=\"button\";\n    rest.className=\"rest\";\n    var rt=document.createElement(\"div\"); rt.className=\"t\"; rt.textContent=\"😴 Sit this one out\";\n    var rs=document.createElement(\"div\"); rs.className=\"s\";\n    rs.textContent=\"+\"+REST_ENERGY+\" energy, no walking — but the crew dances without you (-5 loyalty).\";\n    rest.appendChild(rt); rest.appendChild(rs);\n    rest.addEventListener(\"click\", restSlot);\n    panel.appendChild(rest);\n  }\n\n  /* ---------- route chips ---------- */\n  function renderRoute(){\n    var row=$(\"routeRow\");\n    clear(row);\n    if(state.route.length===0){\n      var empty=document.createElement(\"span\");\n      empty.className=\"chip skip\";\n      empty.textContent=\"No moves yet — the gates just opened.\";\n      row.appendChild(empty);\n      return;\n    }\n    state.route.forEach(function(r){\n      var chip=document.createElement(\"span\");\n      chip.className=\"chip\"+(r.skipped?\" skip\":\"\");\n      var ct=document.createElement(\"span\"); ct.className=\"ct\"; ct.textContent=r.time;\n      chip.appendChild(ct);\n      var lab=document.createElement(\"span\"); lab.textContent=r.label;\n      chip.appendChild(lab);\n      if(r.must){ var s=document.createElement(\"span\"); s.textContent=\"★\"; s.style.color=\"var(--amber)\"; chip.appendChild(s); }\n      if(r.crew){ var c=document.createElement(\"span\"); c.textContent=\"👥\"; chip.appendChild(c); }\n      row.appendChild(chip);\n    });\n  }\n\n  /* ---------- actions ---------- */\n  function chooseAct(act, eCost, steps){\n    state.energy = bound(state.energy - eCost, 0, 100);\n    state.steps += steps;\n    state.at = act.stage;\n    state.visited[act.stage] = true;\n\n    var loyaltyMsg, msgColor;\n    if(act.crew){\n      state.loyalty = bound(state.loyalty + 10, 0, 100);\n      loyaltyMsg=\"Rolled in with the crew — loyalty up. \";\n      msgColor=\"var(--cyan)\";\n    } else {\n      state.loyalty = bound(state.loyalty - 8, 0, 100);\n      loyaltyMsg=\"Split off solo — the crew's a little bummed. \";\n      msgColor=\"var(--purp)\";\n    }\n\n    var mustMsg=\"\";\n    if(act.must){\n      state.caught += 1;\n      mustMsg=\"🔥 Caught a must-see! \";\n      msgColor=\"var(--lime)\";\n    }\n\n    state.route.push({\n      time:act_time(state.idx), label:act.name+\" @ \"+act.stage,\n      stage:act.stage, must:act.must, crew:act.crew, skipped:false\n    });\n\n    setStatus(mustMsg+loyaltyMsg+ (state.energy<25?\"Running low on juice ⚡\":\"\"), msgColor);\n    advance();\n  }\n\n  function restSlot(){\n    var before=state.energy;\n    state.energy = bound(state.energy + REST_ENERGY, 0, 100);\n    state.loyalty = bound(state.loyalty - 5, 0, 100);\n    state.route.push({\n      time:act_time(state.idx), label:\"Sat it out (recharge)\",\n      stage:null, must:false, crew:false, skipped:true\n    });\n    var gained=Math.round(state.energy-before);\n    setStatus(\"Recharged +\"+gained+\" energy. Crew kept dancing without you.\",\"var(--amber)\");\n    advance();\n  }\n\n  function act_time(i){ return BLOCKS[i].time; }\n\n  function advance(){\n    state.idx += 1;\n    renderMeters();\n    renderRoute();\n    if(state.idx >= BLOCKS.length){\n      state.finished=true;\n      renderBlock();\n      showResults();\n    } else {\n      renderBlock();\n    }\n  }\n\n  /* ---------- scoring + results ---------- */\n  function computeScore(){\n    var mustPts = state.caught*180;\n    var loyaltyPts = Math.round(state.loyalty*3.5);\n    var staminaPts = Math.round(state.energy*1.5);\n    var visitedCount = Object.keys(state.visited).length;\n    var varietyPts = visitedCount*25;\n    var total = mustPts+loyaltyPts+staminaPts+varietyPts;\n    return {\n      mustPts:mustPts, loyaltyPts:loyaltyPts, staminaPts:staminaPts,\n      varietyPts:varietyPts, visitedCount:visitedCount, total:total\n    };\n  }\n\n  function gradeFor(total){\n    if(total>=1060) return {g:\"S\", v:\"Festival legend. The crew, your feet, and your soul all left satisfied.\"};\n    if(total>=860)  return {g:\"A\", v:\"Crew MVP. You threaded the schedule like a true route nerd.\"};\n    if(total>=660)  return {g:\"B\", v:\"Solid run. A few regrets, but a great day on the grounds.\"};\n    if(total>=470)  return {g:\"C\", v:\"You survived it. Next time, plan the energy and the walks.\"};\n    return {g:\"D\", v:\"Rough one. Burned out, ditched the crew, missed the heaters. We've all been there.\"};\n  }\n\n  function buildExportText(sc, grade){\n    var lines=[];\n    lines.push(\"🎪 BASSLINE — My Festival Route\");\n    lines.push(\"Score: \"+sc.total+\"  (Grade \"+grade.g+\")\");\n    lines.push(\"--------------------------------------\");\n    state.route.forEach(function(r){\n      var tags=\"\";\n      if(r.must) tags+=\" [must-see]\";\n      if(r.crew) tags+=\" [with crew]\";\n      var pad=r.time;\n      while(pad.length<9) pad+=\" \";\n      lines.push(pad+\"▸ \"+r.label+tags);\n    });\n    lines.push(\"--------------------------------------\");\n    lines.push(\"Must-sees caught : \"+state.caught+\"/\"+TOTAL_MUST);\n    lines.push(\"Crew loyalty     : \"+Math.round(state.loyalty)+\"/100\");\n    lines.push(\"Stamina left     : \"+Math.round(state.energy)+\"/100\");\n    lines.push(\"Stages visited   : \"+sc.visitedCount);\n    lines.push(\"Steps walked     : \"+fmt(state.steps));\n    lines.push(\"\");\n    lines.push(\"Built in BASSLINE — Route the Rave.\");\n    return lines.join(\"\\n\");\n  }\n\n  function bdRow(label,value){\n    var r=document.createElement(\"div\"); r.className=\"bdrow\";\n    var l=document.createElement(\"span\"); l.textContent=label;\n    var v=document.createElement(\"b\"); v.textContent=value;\n    r.appendChild(l); r.appendChild(v);\n    return r;\n  }\n\n  function showResults(){\n    var sc=computeScore();\n    var grade=gradeFor(sc.total);\n    var box=$(\"results\");\n    clear(box);\n    box.style.display=\"block\";\n\n    var big=document.createElement(\"div\"); big.className=\"scoreBig\"; big.textContent=String(sc.total);\n    box.appendChild(big);\n    var g=document.createElement(\"div\"); g.className=\"grade\"; g.textContent=\"Grade \"+grade.g;\n    box.appendChild(g);\n    var v=document.createElement(\"div\"); v.className=\"verdict\"; v.textContent=grade.v;\n    box.appendChild(v);\n\n    var bd=document.createElement(\"div\"); bd.className=\"bd\";\n    bd.appendChild(bdRow(\"Must-sees (\"+state.caught+\"/\"+TOTAL_MUST+\")\", \"+\"+sc.mustPts));\n    bd.appendChild(bdRow(\"Crew loyalty (\"+Math.round(state.loyalty)+\")\", \"+\"+sc.loyaltyPts));\n    bd.appendChild(bdRow(\"Stamina left (\"+Math.round(state.energy)+\")\", \"+\"+sc.staminaPts));\n    bd.appendChild(bdRow(\"Variety (\"+sc.visitedCount+\" stages)\", \"+\"+sc.varietyPts));\n    bd.appendChild(bdRow(\"Steps walked\", fmt(state.steps)));\n    box.appendChild(bd);\n\n    var ta=document.createElement(\"textarea\");\n    ta.id=\"export\"; ta.readOnly=true;\n    ta.value=buildExportText(sc,grade);\n    box.appendChild(ta);\n\n    var btns=document.createElement(\"div\"); btns.className=\"btns\";\n\n    var copyBtn=document.createElement(\"button\");\n    copyBtn.type=\"button\"; copyBtn.className=\"action b-copy\"; copyBtn.textContent=\"📋 Copy route\";\n    copyBtn.addEventListener(\"click\", function(){ copyText(ta.value, copyBtn); });\n\n    var dlBtn=document.createElement(\"button\");\n    dlBtn.type=\"button\"; dlBtn.className=\"action b-dl\"; dlBtn.textContent=\"⬇ Download .txt\";\n    dlBtn.addEventListener(\"click\", function(){ downloadText(ta.value); });\n\n    var resetBtn=document.createElement(\"button\");\n    resetBtn.type=\"button\"; resetBtn.className=\"action b-reset\"; resetBtn.textContent=\"↻ New run\";\n    resetBtn.addEventListener(\"click\", resetGame);\n\n    btns.appendChild(copyBtn);\n    btns.appendChild(dlBtn);\n    btns.appendChild(resetBtn);\n    box.appendChild(btns);\n\n    setStatus(\"That's a wrap. Your route's ready to copy or download. 🎉\",\"var(--lime)\");\n  }\n\n  function copyText(text, btn){\n    var done=function(){\n      var old=btn.textContent;\n      btn.textContent=\"✓ Copied!\";\n      window.setTimeout(function(){ btn.textContent=old; }, 1400);\n    };\n    if(navigator.clipboard && navigator.clipboard.writeText){\n      navigator.clipboard.writeText(text).then(done, function(){\n        selectFallback();\n      });\n    } else {\n      selectFallback();\n    }\n  }\n  function selectFallback(){\n    var ta=$(\"export\");\n    ta.focus(); ta.select();\n    setStatus(\"Couldn't auto-copy — the text is selected, hit your copy shortcut.\",\"var(--amber)\");\n  }\n\n  function downloadText(text){\n    var blob=new Blob([text], {type:\"text/plain\"});\n    var objUrl=URL.createObjectURL(blob);\n    var a=document.createElement(\"a\");\n    a.href=objUrl;\n    a.download=\"bassline-route.txt\";\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    window.setTimeout(function(){ URL.revokeObjectURL(objUrl); }, 800);\n  }\n\n  function resetGame(){\n    state=freshState();\n    $(\"results\").style.display=\"none\";\n    clear($(\"results\"));\n    setStatus(\"Fresh day, new plan. Gates are open. 🎟️\",\"var(--cyan)\");\n    renderMeters();\n    renderRoute();\n    renderBlock();\n  }\n\n  /* ---------- canvas map ---------- */\n  var canvas=$(\"map\");\n  var ctx=canvas.getContext(\"2d\");\n  var dpr=window.devicePixelRatio||1;\n  canvas.width=W*dpr; canvas.height=H*dpr;\n  ctx.scale(dpr,dpr);\n\n  function roundedNode(x,y,r,color,fillAlpha){\n    ctx.beginPath();\n    ctx.arc(x,y,r,0,Math.PI*2);\n    ctx.fillStyle=color;\n    ctx.globalAlpha=fillAlpha;\n    ctx.fill();\n    ctx.globalAlpha=