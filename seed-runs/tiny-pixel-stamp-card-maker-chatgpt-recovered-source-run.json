          "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Pixel Stamp Card Maker</title>\n<style>\n  :root{\n    --bg:#191b22;\n    --panel:#242733;\n    --panel2:#303444;\n    --ink:#f4f1e8;\n    --muted:#b8b2a5;\n    --line:#4d5368;\n    --accent:#ffd166;\n    --danger:#ff6b6b;\n    --ok:#8ce99a;\n    --card:#fff6dc;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n  body{display:flex;justify-content:center;padding:12px}\n  .app{width:min(100%,390px);display:grid;gap:10px}\n  h1{font-size:18px;margin:0;text-align:center;letter-spacing:.04em}\n  .panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:10px;box-shadow:0 8px 24px #0005}\n  .top{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n  label{font-size:12px;color:var(--muted);display:block;margin-bottom:4px}\n  input,select,button{font:inherit}\n  input[type=\"text\"]{width:100%;border:1px solid var(--line);background:#151821;color:var(--ink);border-radius:9px;padding:8px}\n  button{border:1px solid var(--line);background:var(--panel2);color:var(--ink);border-radius:10px;padding:8px 9px;cursor:pointer;touch-action:manipulation}\n  button:active{transform:translateY(1px)}\n  button.primary{background:#51432a;border-color:#8f7534;color:#fff2bf}\n  button.danger{background:#4a252b;border-color:#8b3d46;color:#ffd7dc}\n  .canvasWrap{display:grid;place-items:center;overflow:hidden}\n  canvas{image-rendering:pixelated;image-rendering:crisp-edges;max-width:100%;touch-action:none;border-radius:12px}\n  #cardCanvas{width:360px;height:500px;background:var(--card);border:1px solid #0006}\n  .tools{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}\n  .stampGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}\n  .stampBtn{height:42px;padding:3px;display:grid;place-items:center}\n  .stampBtn.active{outline:2px solid var(--accent);background:#3b3324}\n  .mini{width:32px;height:32px;image-rendering:pixelated}\n  .palette{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}\n  .swatch{height:36px;border-radius:10px;border:2px solid #0008;position:relative;padding:0}\n  .swatch.active{outline:2px solid var(--ink);outline-offset:2px}\n  .swatch input{opacity:0;position:absolute;inset:0;width:100%;height:100%;cursor:pointer}\n  .hint{font-size:12px;color:var(--muted);line-height:1.35;text-align:center}\n  .exportRow{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n  .status{font-size:12px;color:var(--ok);min-height:16px;text-align:center}\n  @media print{\n    body{background:white;padding:0}\n    .app{width:100%;display:block}\n    .panel:not(.printOnly),h1,.status{display:none}\n    .printOnly{display:block;border:0;box-shadow:none;padding:0}\n    #cardCanvas{width:3.5in;height:auto;border:0}\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <h1>Pixel Stamp Card Maker</h1>\n\n  <div class=\"panel top\">\n    <div>\n      <label for=\"title\">Card title</label>\n      <input id=\"title\" type=\"text\" maxlength=\"24\" value=\"BUG HUNTER BADGE\">\n    </div>\n    <div>\n      <label for=\"subtitle\">Subtitle</label>\n      <input id=\"subtitle\" type=\"text\" maxlength=\"28\" value=\"collector stamp card\">\n    </div>\n  </div>\n\n  <div class=\"panel printOnly\">\n    <div class=\"canvasWrap\">\n      <canvas id=\"cardCanvas\" width=\"720\" height=\"1000\" aria-label=\"Printable pixel collector card\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <label>Choose stamp</label>\n    <div id=\"stamps\" class=\"stampGrid\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <label>Palette, tap color chip to use, open picker to recolor</label>\n    <div id=\"palette\" class=\"palette\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <div class=\"tools\">\n      <button id=\"undo\">Undo</button>\n      <button id=\"clear\" class=\"danger\">Clear</button>\n      <button id=\"randomize\">Recolor</button>\n      <button id=\"print\" class=\"primary\">Print</button>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <div class=\"exportRow\">\n      <button id=\"copy\" class=\"primary\">Copy PNG</button>\n      <button id=\"download\" class=\"primary\">Download PNG</button>\n    </div>\n    <p class=\"hint\">Tap or drag on the card to place stamps. Recoloring updates every stamp already placed.</p>\n    <div id=\"status\" class=\"status\"></div>\n  </div>\n</div>\n\n<script>\n(() => {\n  \"use strict\";\n\n  const canvas = document.getElementById(\"cardCanvas\");\n  const ctx = canvas.getContext(\"2d\");\n  const titleInput = document.getElementById(\"title\");\n  const subtitleInput = document.getElementById(\"subtitle\");\n  const stampsEl = document.getElementById(\"stamps\");\n  const paletteEl = document.getElementById(\"palette\");\n  const statusEl = document.getElementById(\"status\");\n\n  const card = { w:720, h:1000, pad:52, gridX:84, gridY:250, cols:9, rows:8, cell:62 };\n\n  let colors = [\"#1d2b53\",\"#7e2553\",\"#008751\",\"#ab5236\",\"#5f574f\",\"#c2c3c7\"];\n  let activeColor = 0;\n  let activeStamp = 0;\n  let placed = [];\n  let history = [];\n  let lastCellKey = \"\";\n  let drawing = false;\n\n  const stamps = [\n    {name:\"star\", px:[\"00100\",\"01110\",\"11111\",\"01110\",\"01010\"]},\n    {name:\"heart\", px:[\"01010\",\"11111\",\"11111\",\"01110\",\"00100\"]},\n    {name:\"bug\", px:[\"01010\",\"11111\",\"10101\",\"11111\",\"01010\"]},\n    {name:\"sword\", px:[\"00100\",\"00100\",\"00100\",\"01110\",\"00100\"]},\n    {name:\"gem\", px:[\"01110\",\"11111\",\"11111\",\"01110\",\"00100\"]},\n    {name:\"skull\", px:[\"01110\",\"10101\",\"11111\",\"01110\",\"01010\"]},\n    {name:\"bolt\", px:[\"00110\",\"01100\",\"11110\",\"00110\",\"01100\"]},\n    {name:\"leaf\", px:[\"00100\",\"01110\",\"11100\",\"01110\",\"00100\"]},\n    {name:\"moon\", px:[\"01110\",\"11000\",\"11000\",\"11000\",\"01110\"]},\n    {name:\"flag\", px:[\"11110\",\"10110\",\"11110\",\"10000\",\"10000\"]},\n    {name:\"key\", px:[\"01100\",\"10010\",\"01100\",\"00111\",\"00010\"]},\n    {name:\"cat\", px:[\"10001\",\"11111\",\"10101\",\"11111\",\"01010\"]}\n  ];\n\n  function saveHistory(){\n    history.push(JSON.stringify(placed));\n    if(history.length > 80) history.shift();\n  }\n\n  function text(s,x,y,size,align=\"center\",color=\"#2b2430\"){\n    ctx.fillStyle = color;\n    ctx.font = `${size}px monospace`;\n    ctx.textAlign = align;\n    ctx.textBaseline = \"middle\";\n    ctx.fillText(s,x,y);\n  }\n\n  function drawPixelStamp(stampIndex, colorIndex, x, y, scale){\n    const map = stamps[stampIndex].px;\n    ctx.fillStyle = colors[colorIndex];\n    for(let r=0;r<map.length;r++){\n      for(let c=0;c<map[r].length;c++){\n        if(map[r][c] === \"1\") ctx.fillRect(x + c*scale, y + r*scale, scale, scale);\n      }\n    }\n    ctx.fillStyle = \"rgba(0,0,0,.16)\";\n    for(let r=0;r<map.length;r++){\n      for(let c=0;c<map[r].length;c++){\n        if(map[r][c] === \"1\") ctx.fillRect(x + c*scale, y + r*scale, Math.max(1,scale*.16), scale);\n      }\n    }\n  }\n\n  function render(){\n    ctx.clearRect(0,0,card.w,card.h);\n\n    ctx.fillStyle = \"#fff6dc\";\n    ctx.fillRect(0,0,card.w,card.h);\n\n    ctx.fillStyle = \"#f0dca7\";\n    ctx.fillRect(28,28,card.w-56,card.h-56);\n\n    ctx.fillStyle = \"#fff6dc\";\n    ctx.fillRect(42,42,card.w-84,card.h-84);\n\n    ctx.strokeStyle = \"#2b2430\";\n    ctx.lineWidth = 6;\n    ctx.strokeRect(42,42,card.w-84,card.h-84);\n    ctx.lineWidth = 2;\n    ctx.strokeRect(62,62,card.w-124,card.h-124);\n\n    text(titleInput.value.toUpperCase() || \"PIXEL CARD\", card.w/2, 108, 34);\n    text(subtitleInput.value.toLowerCase() || \"collector stamp card\", card.w/2, 154, 20, \"center\", \"#6d5d4b\");\n\n    ctx.fillStyle = \"#ead290\";\n    ctx.fillRect(84,188,552,34);\n    text(\"STAMP ZONE\", card.w/2, 206, 18, \"center\", \"#5c4428\");\n\n    for(let r=0;r<card.rows;r++){\n      for(let c=0;c<card.cols;c++){\n        const x = card.gridX + c*card.cell;\n        const y = card.gridY + r*card.cell;\n        ctx.fillStyle = (r+c)%2 ? \"#fff0c5\" : \"#ffe8ad\";\n        ctx.fillRect(x,y,card.cell-6,card.cell-6);\n        ctx.strokeStyle = \"#c49b54\";\n        ctx.lineWidth = 2;\n        ctx.strokeRect(x+1,y+1,card.cell-8,card.cell-8);\n      }\n    }\n\n    for(const p of placed){\n      const x = card.gridX + p.c*card.cell + 10;\n      const y = card.gridY + p.r*card.cell + 10;\n      drawPixelStamp(p.stamp, p.color, x, y, 8);\n    }\n\n    ctx.fillStyle = \"#2b2430\";\n    ctx.fillRect(86,802,548,80);\n    text(\"FOUND BY\", 144, 824, 16, \"left\", \"#ffe8ad\");\n    ctx.strokeStyle = \"#ffe8ad\";\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.moveTo(248,842);\n    ctx.lineTo(596,842);\n    ctx.stroke();\n\n    text(`${placed.length}/${card.cols*card.rows} STAMPS`, card.w/2, 920, 22, \"center\", \"#2b2430\");\n    text(\"made with tiny pixels\", card.w/2, 956, 16, \"center\", \"#7b684c\");\n  }\n\n  function makeMiniCanvas(stampIndex){\n    const m = document.createElement(\"canvas\");\n    m.width = 35;\n    m.height = 35;\n    m.className = \"mini\";\n    const mctx = m.getContext(\"2d\");\n    const map = stamps[stampIndex].px;\n    mctx.fillStyle = colors[activeColor];\n    for(let r=0;r<map.length;r++){\n      for(let c=0;c<map[r].length;c++){\n        if(map[r][c] === \"1\") mctx.fillRect(c*7,r*7,7,7);\n      }\n    }\n    return m;\n  }\n\n  function buildStamps(){\n    stampsEl.innerHTML = \"\";\n    stamps.forEach((s,i) => {\n      const b = document.createElement(\"button\");\n      b.className = \"stampBtn\" + (i === activeStamp ? \" active\" : \"\");\n      b.type = \"button\";\n      b.title = s.name;\n      b.setAttribute(\"aria-label\", `Use ${s.name} stamp`);\n      b.appendChild(makeMiniCanvas(i));\n      b.onclick = () => {\n        activeStamp = i;\n        buildStamps();\n      };\n      stampsEl.appendChild(b);\n    });\n  }\n\n  function buildPalette(){\n    paletteEl.innerHTML = \"\";\n    colors.forEach((col,i) => {\n      const b = document.createElement(\"button\");\n      b.className = \"swatch\" + (i === activeColor ? \" active\" : \"\");\n      b.style.background = col;\n      b.type = \"button\";\n      b.title = `Color ${i+1}`;\n      b.setAttribute(\"aria-label\", `Use color ${i+1}`);\n      b.onclick = () => {\n        activeColor = i;\n        buildPalette();\n        buildStamps();\n      };\n      const inp = document.createElement(\"input\");\n      inp.type = \"color\";\n      inp.value = col;\n      inp.setAttribute(\"aria-label\", `Change color ${i+1}`);\n      inp.oninput = e => {\n        colors[i] = e.target.value;\n        b.style.background = colors[i];\n        render();\n        buildStamps();\n      };\n      b.appendChild(inp);\n      paletteEl.appendChild(b);\n    });\n  }\n\n  function getCell(ev){\n    const rect = canvas.getBoundingClientRect();\n    const sx = canvas.width / rect.width;\n    const sy = canvas.height / rect.height;\n    const x = (ev.clientX - rect.left) * sx;\n    const y = (ev.clientY - rect.top) * sy;\n    const c = Math.floor((x - card.gridX) / card.cell);\n    const r = Math.floor((y - card.gridY) / card.cell);\n    if(c < 0 || c >= card.cols || r < 0 || r >= card.rows) return null;\n    return {r,c,key:`${r},${c}`};\n  }\n\n  function placeAt(ev){\n    const cell = getCell(ev);\n    if(!cell || cell.key === lastCellKey) return;\n    lastCellKey = cell.key;\n    saveHistory();\n    const existing = placed.findIndex(p => p.r === cell.r && p.c === cell.c);\n    const stamp = {r:cell.r,c:cell.c,stamp:activeStamp,color:activeColor};\n    if(existing >= 0) placed[existing] = stamp;\n    else placed.push(stamp);\n    render();\n  }\n\n  canvas.addEventListener(\"pointerdown\", ev => {\n    drawing = true;\n    canvas.setPointerCapture(ev.pointerId);\n    lastCellKey = \"\";\n    placeAt(ev);\n  });\n  canvas.addEventListener(\"pointermove\", ev => {\n    if(drawing) placeAt(ev);\n  });\n  canvas.addEventListener(\"pointerup\", () => {\n    drawing = false;\n    lastCellKey = \"\";\n  });\n  canvas.addEventListener(\"pointercancel\", () => {\n    drawing = false;\n    lastCellKey = \"\";\n  });\n\n  document.getElementById(\"undo\").onclick = () => {\n    const prev = history.pop();\n    if(prev) placed = JSON.parse(prev);\n    render();\n  };\n\n  document.getElementById(\"clear\").onclick = () => {\n    saveHistory();\n    placed = [];\n    render();\n  };\n\n  document.getElementById(\"randomize\").onclick = () => {\n    const base = Math.floor(Math.random()*360);\n    colors = colors.map((_,i) => `hsl(${(base+i*47)%360} 72% ${i%2?42:58}%)`);\n    buildPalette();\n    buildStamps();\n    render();\n  };\n\n  document.getElementById(\"print\").onclick = () => window.print();\n\n  document.getElementById(\"download\").onclick = () => {\n    render();\n    const a = document.createElement(\"a\");\n    a.download = \"pixel-stamp-card.png\";\n    a.href = canvas.toDataURL(\"image/png\");\n    a.click();\n    flash(\"Downloaded PNG.\");\n  };\n\n  document.getElementById(\"copy\").onclick = async () => {\n    render();\n    try{\n      const blob = await new Promise(resolve => canvas.toBlob(resolve, \"image/png\"));\n      await navigator.clipboard.write([new ClipboardItem({\"image/png\": blob})]);\n      flash(\"Copied PNG to clipboard.\");\n    }catch(err){\n      flash(\"Copy failed. Use Download PNG instead.\", true);\n    }\n  };\n\n  function flash(msg,bad=false){\n    statusEl.textContent = msg;\n    statusEl.style.color = bad ? \"var(--danger)\" : \"var(--ok)\";\n    clearTimeout(flash.t);\n    flash.t = setTimeout(() => statusEl.textContent = \"\", 2200);\n  }\n\n  titleInput.addEventListener(\"input\", render);\n  subtitleInput.addEventListener(\"input\", render);\n\n  buildPalette();\n  buildStamps();\n  render();\n})();\n</script>\n</body>\n</html>",
          "code": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Pixel Stamp Card Maker</title>\n<style>\n  :root{\n    --bg:#191b22;\n    --panel:#242733;\n    --panel2:#303444;\n    --ink:#f4f1e8;\n    --muted:#b8b2a5;\n    --line:#4d5368;\n    --accent:#ffd166;\n    --danger:#ff6b6b;\n    --ok:#8ce99a;\n    --card:#fff6dc;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n  body{display:flex;justify-content:center;padding:12px}\n  .app{width:min(100%,390px);display:grid;gap:10px}\n  h1{font-size:18px;margin:0;text-align:center;letter-spacing:.04em}\n  .panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:10px;box-shadow:0 8px 24px #0005}\n  .top{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n  label{font-size:12px;color:var(--muted);display:block;margin-bottom:4px}\n  input,select,button{font:inherit}\n  input[type=\"text\"]{width:100%;border:1px solid var(--line);background:#151821;color:var(--ink);border-radius:9px;padding:8px}\n  button{border:1px solid var(--line);background:var(--panel2);color:var(--ink);border-radius:10px;padding:8px 9px;cursor:pointer;touch-action:manipulation}\n  button:active{transform:translateY(1px)}\n  button.primary{background:#51432a;border-color:#8f7534;color:#fff2bf}\n  button.danger{background:#4a252b;border-color:#8b3d46;color:#ffd7dc}\n  .canvasWrap{display:grid;place-items:center;overflow:hidden}\n  canvas{image-rendering:pixelated;image-rendering:crisp-edges;max-width:100%;touch-action:none;border-radius:12px}\n  #cardCanvas{width:360px;height:500px;background:var(--card);border:1px solid #0006}\n  .tools{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}\n  .stampGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}\n  .stampBtn{height:42px;padding:3px;display:grid;place-items:center}\n  .stampBtn.active{outline:2px solid var(--accent);background:#3b3324}\n  .mini{width:32px;height:32px;image-rendering:pixelated}\n  .palette{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}\n  .swatch{height:36px;border-radius:10px;border:2px solid #0008;position:relative;padding:0}\n  .swatch.active{outline:2px solid var(--ink);outline-offset:2px}\n  .swatch input{opacity:0;position:absolute;inset:0;width:100%;height:100%;cursor:pointer}\n  .hint{font-size:12px;color:var(--muted);line-height:1.35;text-align:center}\n  .exportRow{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n  .status{font-size:12px;color:var(--ok);min-height:16px;text-align:center}\n  @media print{\n    body{background:white;padding:0}\n    .app{width:100%;display:block}\n    .panel:not(.printOnly),h1,.status{display:none}\n    .printOnly{display:block;border:0;box-shadow:none;padding:0}\n    #cardCanvas{width:3.5in;height:auto;border:0}\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <h1>Pixel Stamp Card Maker</h1>\n\n  <div class=\"panel top\">\n    <div>\n      <label for=\"title\">Card title</label>\n      <input id=\"title\" type=\"text\" maxlength=\"24\" value=\"BUG HUNTER BADGE\">\n    </div>\n    <div>\n      <label for=\"subtitle\">Subtitle</label>\n      <input id=\"subtitle\" type=\"text\" maxlength=\"28\" value=\"collector stamp card\">\n    </div>\n  </div>\n\n  <div class=\"panel printOnly\">\n    <div class=\"canvasWrap\">\n      <canvas id=\"cardCanvas\" width=\"720\" height=\"1000\" aria-label=\"Printable pixel collector card\"></canvas>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <label>Choose stamp</label>\n    <div id=\"stamps\" class=\"stampGrid\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <label>Palette, tap color chip to use, open picker to recolor</label>\n    <div id=\"palette\" class=\"palette\"></div>\n  </div>\n\n  <div class=\"panel\">\n    <div class=\"tools\">\n      <button id=\"undo\">Undo</button>\n      <button id=\"clear\" class=\"danger\">Clear</button>\n      <button id=\"randomize\">Recolor</button>\n      <button id=\"print\" class=\"primary\">Print</button>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <div class=\"exportRow\">\n      <button id=\"copy\" class=\"primary\">Copy PNG</button>\n      <button id=\"download\" class=\"primary\">Download PNG</button>\n    </div>\n    <p class=\"hint\">Tap or drag on the card to place stamps. Recoloring updates every stamp already placed.</p>\n    <div id=\"status\" class=\"status\"></div>\n  </div>\n</div>\n\n<script>\n(() => {\n  \"use strict\";\n\n  const canvas = document.getElementById(\"cardCanvas\");\n  const ctx = canvas.getContext(\"2d\");\n  const titleInput = document.getElementById(\"title\");\n  const subtitleInput = document.getElementById(\"subtitle\");\n  const stampsEl = document.getElementById(\"stamps\");\n  const paletteEl = document.getElementById(\"palette\");\n  const statusEl = document.getElementById(\"status\");\n\n  const card = { w:720, h:1000, pad:52, gridX:84, gridY:250, cols:9, rows:8, cell:62 };\n\n  let colors = [\"#1d2b53\",\"#7e2553\",\"#008751\",\"#ab5236\",\"#5f574f\",\"#c2c3c7\"];\n  let activeColor = 0;\n  let activeStamp = 0;\n  let placed = [];\n  let history = [];\n  let lastCellKey = \"\";\n  let drawing = false;\n\n  const stamps = [\n    {name:\"star\", px:[\"00100\",\"01110\",\"11111\",\"01110\",\"01010\"]},\n    {name:\"heart\", px:[\"01010\",\"11111\",\"11111\",\"01110\",\"00100\"]},\n    {name:\"bug\", px:[\"01010\",\"11111\",\"10101\",\"11111\",\"01010\"]},\n    {name:\"sword\", px:[\"00100\",\"00100\",\"00100\",\"01110\",\"00100\"]},\n    {name:\"gem\", px:[\"01110\",\"11111\",\"11111\",\"01110\",\"00100\"]},\n    {name:\"skull\", px:[\"01110\",\"10101\",\"11111\",\"01110\",\"01010\"]},\n    {name:\"bolt\", px:[\"00110\",\"01100\",\"11110\",\"00110\",\"01100\"]},\n    {name:\"leaf\", px:[\"00100\",\"01110\",\"11100\",\"01110\",\"00100\"]},\n    {name:\"moon\", px:[\"01110\",\"11000\",\"11000\",\"11000\",\"01110\"]},\n    {name:\"flag\", px:[\"11110\",\"10110\",\"11110\",\"10000\",\"10000\"]},\n    {name:\"key\", px:[\"01100\",\"10010\",\"01100\",\"00111\",\"00010\"]},\n    {name:\"cat\", px:[\"10001\",\"11111\",\"10101\",\"11111\",\"01010\"]}\n  ];\n\n  function saveHistory(){\n    history.push(JSON.stringify(placed));\n    if(history.length > 80) history.shift();\n  }\n\n  function text(s,x,y,size,align=\"center\",color=\"#2b2430\"){\n    ctx.fillStyle = color;\n    ctx.font = `${size}px monospace`;\n    ctx.textAlign = align;\n    ctx.textBaseline = \"middle\";\n    ctx.fillText(s,x,y);\n  }\n\n  function drawPixelStamp(stampIndex, colorIndex, x, y, scale){\n    const map = stamps[stampIndex].px;\n    ctx.fillStyle = colors[colorIndex];\n    for(let r=0;r<map.length;r++){\n      for(let c=0;c<map[r].length;c++){\n        if(map[r][c] === \"1\") ctx.fillRect(x + c*scale, y + r*scale, scale, scale);\n      }\n    }\n    ctx.fillStyle = \"rgba(0,0,0,.16)\";\n    for(let r=0;r<map.length;r++){\n      for(let c=0;c<map[r].length;c++){\n        if(map[r][c] === \"1\") ctx.fillRect(x + c*scale, y + r*scale, Math.max(1,scale*.16), scale);\n      }\n    }\n  }\n\n  function render(){\n    ctx.clearRect(0,0,card.w,card.h);\n\n    ctx.fillStyle = \"#fff6dc\";\n    ctx.fillRect(0,0,card.w,card.h);\n\n    ctx.fillStyle = \"#f0dca7\";\n    ctx.fillRect(28,28,card.w-56,card.h-56);\n\n    ctx.fillStyle = \"#fff6dc\";\n    ctx.fillRect(42,42,card.w-84,card.h-84);\n\n    ctx.strokeStyle = \"#2b2430\";\n    ctx.lineWidth = 6;\n    ctx.strokeRect(42,42,card.w-84,card.h-84);\n    ctx.lineWidth = 2;\n    ctx.strokeRect(62,62,card.w-124,card.h-124);\n\n    text(titleInput.value.toUpperCase() || \"PIXEL CARD\", card.w/2, 108, 34);\n    text(subtitleInput.value.toLowerCase() || \"collector stamp card\", card.w/2, 154, 20, \"center\", \"#6d5d4b\");\n\n    ctx.fillStyle = \"#ead290\";\n    ctx.fillRect(84,188,552,34);\n    text(\"STAMP ZONE\", card.w/2, 206, 18, \"center\", \"#5c4428\");\n\n    for(let r=0;r<card.rows;r++){\n      for(let c=0;c<card.cols;c++){\n        const x = card.gridX + c*card.cell;\n        const y = card.gridY + r*card.cell;\n        ctx.fillStyle = (r+c)%2 ? \"#fff0c5\" : \"#ffe8ad\";\n        ctx.fillRect(x,y,card.cell-6,card.cell-6);\n        ctx.strokeStyle = \"#c49b54\";\n        ctx.lineWidth = 2;\n        ctx.strokeRect(x+1,y+1,card.cell-8,card.cell-8);\n      }\n    }\n\n    for(const p of placed){\n      const x = card.gridX + p.c*card.cell + 10;\n      const y = card.gridY + p.r*card.cell + 10;\n      drawPixelStamp(p.stamp, p.color, x, y, 8);\n    }\n\n    ctx.fillStyle = \"#2b2430\";\n    ctx.fillRect(86,802,548,80);\n    text(\"FOUND BY\", 144, 824, 16, \"left\", \"#ffe8ad\");\n    ctx.strokeStyle = \"#ffe8ad\";\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.moveTo(248,842);\n    ctx.lineTo(596,842);\n    ctx.stroke();\n\n    text(`${placed.length}/${card.cols*card.rows} STAMPS`, card.w/2, 920, 22, \"center\", \"#2b2430\");\n    text(\"made with tiny pixels\", card.w/2, 956, 16, \"center\", \"#7b684c\");\n  }\n\n  function makeMiniCanvas(stampIndex){\n    const m = document.createElement(\"canvas\");\n    m.width = 35;\n    m.height = 35;\n    m.className = \"mini\";\n    const mctx = m.getContext(\"2d\");\n    const map = stamps[stampIndex].px;\n    mctx.fillStyle = colors[activeColor];\n    for(let r=0;r<map.length;r++){\n      for(let c=0;c<map[r].length;c++){\n        if(map[r][c] === \"1\") mctx.fillRect(c*7,r*7,7,7);\n      }\n    }\n    return m;\n  }\n\n  function buildStamps(){\n    stampsEl.innerHTML = \"\";\n    stamps.forEach((s,i) => {\n      const b = document.createElement(\"button\");\n      b.className = \"stampBtn\" + (i === activeStamp ? \" active\" : \"\");\n      b.type = \"button\";\n      b.title = s.name;\n      b.setAttribute(\"aria-label\", `Use ${s.name} stamp`);\n      b.appendChild(makeMiniCanvas(i));\n      b.onclick = () => {\n        activeStamp = i;\n        buildStamps();\n      };\n      stampsEl.appendChild(b);\n    });\n  }\n\n  function buildPalette(){\n    paletteEl.innerHTML = \"\";\n    colors.forEach((col,i) => {\n      const b = document.createElement(\"button\");\n      b.className = \"swatch\" + (i === activeColor ? \" active\" : \"\");\n      b.style.background = col;\n      b.type = \"button\";\n      b.title = `Color ${i+1}`;\n      b.setAttribute(\"aria-label\", `Use color ${i+1}`);\n      b.onclick = () => {\n        activeColor = i;\n        buildPalette();\n        buildStamps();\n      };\n      const inp = document.createElement(\"input\");\n      inp.type = \"color\";\n      inp.value = col;\n      inp.setAttribute(\"aria-label\", `Change color ${i+1}`);\n      inp.oninput = e => {\n        colors[i] = e.target.value;\n        b.style.background = colors[i];\n        render();\n        buildStamps();\n      };\n      b.appendChild(inp);\n      paletteEl.appendChild(b);\n    });\n  }\n\n  function getCell(ev){\n    const rect = canvas.getBoundingClientRect();\n    const sx = canvas.width / rect.width;\n    const sy = canvas.height / rect.height;\n    const x = (ev.clientX - rect.left) * sx;\n    const y = (ev.clientY - rect.top) * sy;\n    const c = Math.floor((x - card.gridX) / card.cell);\n    const r = Math.floor((y - card.gridY) / card.cell);\n    if(c < 0 || c >= card.cols || r < 0 || r >= card.rows) return null;\n    return {r,c,key:`${r},${c}`};\n  }\n\n  function placeAt(ev){\n    const cell = getCell(ev);\n    if(!cell || cell.key === lastCellKey) return;\n    lastCellKey = cell.key;\n    saveHistory();\n    const existing = placed.findIndex(p => p.r === cell.r && p.c === cell.c);\n    const stamp = {r:cell.r,c:cell.c,stamp:activeStamp,color:activeColor};\n    if(existing >= 0) placed[existing] = stamp;\n    else placed.push(stamp);\n    render();\n  }\n\n  canvas.addEventListener(\"pointerdown\", ev => {\n    drawing = true;\n    canvas.setPointerCapture(ev.pointerId);\n    lastCellKey = \"\";\n    placeAt(ev);\n  });\n  canvas.addEventListener(\"pointermove\", ev => {\n    if(drawing) placeAt(ev);\n  });\n  canvas.addEventListener(\"pointerup\", () => {\n    drawing = false;\n    lastCellKey = \"\";\n  });\n  canvas.addEventListener(\"pointercancel\", () => {\n    drawing = false;\n    lastCellKey = \"\";\n  });\n\n  document.getElementById(\"undo\").onclick = () => {\n    const prev = history.pop();\n    if(prev) placed = JSON.parse(prev);\n    render();\n  };\n\n  document.getElementById(\"clear\").onclick = () => {\n    saveHistory();\n    placed = [];\n    render();\n  };\n\n  document.getElementById(\"randomize\").onclick = () => {\n    const base = Math.floor(Math.random()*360);\n    colors = colors.map((_,i) => `hsl(${(base+i*47)%360} 72% ${i%2?42:58}%)`);\n    buildPalette();\n    buildStamps();\n    render();\n  };\n\n  document.getElementById(\"print\").onclick = () => window.print();\n\n  document.getElementById(\"download\").onclick = () => {\n    render();\n    const a = document.createElement(\"a\");\n    a.download = \"pixel-stamp-card.png\";\n    a.href = canvas.toDataURL(\"image/png\");\n    a.click();\n    flash(\"Downloaded PNG.\");\n  };\n\n  document.getElementById(\"copy\").onclick = async () => {\n    render();\n    try{\n      const blob = await new Promise(resolve => canvas.toBlob(resolve, \"image/png\"));\n      await navigator.clipboard.write([new ClipboardItem({\"image/png\": blob})]);\n      flash(\"Copied PNG to clipboard.\");\n    }catch(err){\n      flash(\"Copy failed. Use Download PNG instead.\", true);\n    }\n  };\n\n  function flash(msg,bad=false){\n    statusEl.textContent = msg;\n    statusEl.style.color = bad ? \"var(--danger)\" : \"var(--ok)\";\n    clearTimeout(flash.t);\n    flash.t = setTimeout(() => statusEl.textContent = \"\", 2200);\n  }\n\n  titleInput.addEventListener(\"input\", render);\n  subtitleInput.addEventListener(\"input\", ren